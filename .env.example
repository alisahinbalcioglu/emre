# ═════════════════════════════════════════════════════════════════
#  MetaPrice VPS — docker-compose environment
#  Kopyala:  cp .env.example .env   → degerleri doldur
#  .env ASLA commit edilmez (.gitignore'da).
# ═════════════════════════════════════════════════════════════════

# ── Domain + HTTPS ──────────────────────────────────────────────
DOMAIN=metapricex.com
ACME_EMAIL=emre.basarann1@gmail.com

# ── PostgreSQL ──────────────────────────────────────────────────
POSTGRES_USER=metaprice
# Guclu bir sifre uret:  openssl rand -base64 24
POSTGRES_PASSWORD=DEGISTIR_guclu_sifre
POSTGRES_DB=metaprice

# ── JWT (login token imzasi) ────────────────────────────────────
# Uret:  openssl rand -base64 48
JWT_SECRET=DEGISTIR_uzun_rastgele

# ── DWG engine ic token (NestJS <-> Python ayni deger) ──────────
# Uret:  openssl rand -base64 32
INTERNAL_API_TOKEN=DEGISTIR_uzun_rastgele

# ── Claude API (PDF/DWG AI ozellikleri) ─────────────────────────
ANTHROPIC_API_KEY=sk-ant-DEGISTIR

# ═════════════════════════════════════════════════════════════════
#  ADIM 2 — ODEME / ABONELIK (iyzico)
# ═════════════════════════════════════════════════════════════════
#
#  ⚠ HER DEGISKEN IKI YERE YAZILIR: burasi (deger) VE docker-compose.yml
#  backend.environment blogu (konteynere gecis). Yalniz buraya yazmak
#  YETMEZ — compose'da anilmayan degisken konteynere GECMEZ.
#
#  ⚠ HICBIRI ZORUNLU DEGIL: eksikse uygulama ONYUKLENIR, yalnizca odeme
#  uclari 503 doner. Odeme yapilandirmasi tum urunu rehin almaz.
#  Eksik degisken varsa acilista WARN gunlugu duser (sessiz kalmaz).

# ── iyzico kimlik ───────────────────────────────────────────────
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# Panelden alinan UYE ISYERI NUMARASI (MID). Webhook GOVDESINDE GELMEZ;
# imza hesabi bunu buradan okur. YANLISSA IMZA HIC TUTMAZ — imza
# uyusmazliginin en olasi sebebi budur (kod beklenen iki imzayi da
# gunluge basar, karsilastirip dogrulayin).
IYZICO_MERCHANT_ID=

# Sandbox : https://sandbox-api.iyzipay.com
# Canli   : https://api.iyzipay.com
IYZICO_TABAN_URL=https://sandbox-api.iyzipay.com

# ── Webhook imzasi (X-IYZ-SIGNATURE-V3) ─────────────────────────
#
# ⚠ BU OZELLIK HESAP BAZINDA ACILIR ve varsayilan KAPALIDIR.
# entegrasyon@iyzico.com'a yazilarak actirilir.
# SANDBOX icin acilmis olmasi CANLI icin acildigi anlamina GELMEZ —
# production hesabi icin AYRI talep gerekir. Canli deploy gununde
# atlanirsa her webhook reddedilir ve sebebi gec anlasilir.
#
# ⚠ ILK GERCEK WEBHOOK'A KADAR false KALSIN. true yapilir ve imza
# tutmazsa her olay sessizce dusulur.
IYZICO_IMZA_ZORUNLU=false
#
# Dokumanda celiski var: duz metin bir alan sirasi, ayni sayfadaki dort
# kod ornegi baskasini veriyor. Kod IKISINI DE hesaplar ve tutani
# gunluge basar:
#     Imza dogrulandi. Alan sirasi: "merchantId-once".
#     IYZICO_IMZA_SIRASI=merchantId-once olarak sabitleyin.
# O satiri gorunce degeri buraya yazin; o andan sonra tek sira denenir.
# Gecerli degerler: merchantId-once | secretKey-once
IYZICO_IMZA_SIRASI=

# ── Uygulama ────────────────────────────────────────────────────
# Dunning e-postalarindaki baglantilarin koku. Bos birakilirsa
# compose https://${DOMAIN} kullanir.
UYGULAMA_URL=
# Fatura kesilemedigi zaman (ELLE_MUDAHALE) bildirim gidecek adres.
YONETIM_EPOSTA=
KDV_ORANI=20

# ── Dunning merdiveni (gun, basarisiz tahsilattan itibaren) ─────
# 0  → bildirim + kart guncelleme baglantisi   (erisim TAM)
# 3  → tekrar dene, olmazsa 2. bildirim        (erisim TAM)
# 7  → tekrar dene, "N gun sonra kisitlanacak" (erisim TAM)
# 10 → SALT-OKUNUR moda gecer                  (KISITLI)
# 20 → tekrar dene, son uyari
# 30 → erisim kapanir                          (ASKIDA)
# ⚠ Taahhut sektorunde muhasebe dongusu yavastir; 10 gun agresif
# olabilir. 14 / 45 daha uygun olabilir — ilk uc ay verisiyle ayarlayin.
DUNNING_GUN_1=3
DUNNING_GUN_2=7
DUNNING_KISIT_GUNU=10
DUNNING_GUN_3=20
DUNNING_ASKI_GUNU=30

# ── E-posta ─────────────────────────────────────────────────────
#
# ⚠⚠ BOSSA DUNNING SESSIZ CALISIR. Merdiven yine ilerler: musteri 10.
# gun kisitlanir, 30. gun askiya alinir — ama HICBIR UYARI ALMAZ.
# Bu, dunning'i hic kosturmamaktan DAHA KOTUDUR: musteri hesabinin
# neden kapandigini bilmez. Canliya cikmadan once doldurulmali.
RESEND_API_KEY=
EPOSTA_GONDEREN=MetaPriceX <bildirim@metapricex.com>

# ── Muhasebe / e-fatura ─────────────────────────────────────────
# "parasut" YAZMADIKCA hicbir yere fatura gitmez (sahte adaptor
# yalnizca gunluge yazar). ⚠ Parasut adaptoru DOGRULANMADI — alan
# adlarini ve uc noktalari kendi hesabinizin dokumanindan teyit edin.
MUHASEBE_SAGLAYICI=sahte
PARASUT_FIRMA_ID=
PARASUT_CLIENT_ID=
PARASUT_CLIENT_SECRET=
PARASUT_KULLANICI=
PARASUT_PAROLA=
