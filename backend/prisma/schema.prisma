generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  user
}

enum UserStatus {
  active
  banned
}

enum Tier {
  core
  pro
  suite
}

enum PackageLevel {
  core
  pro
}

enum SubscriptionScope {
  mechanical
  electrical
  mep
}

// ─────────────────────────────────────────────────────────────────────
// FIRMA (ADIM 1, 20.08) — hesap artik KISI degil FIRMA.
// Firmaya ait: teklifler, kutuphane, malzeme havuzu aktarimi, iskontolar,
// iscilik firmalari, ABONELIK. Kisiye ait: kimlik, oturum, yetkiler.
// ⚠ CLERK KULLANILMIYOR (kullanici karari 20.08): kimlik mevcut JWT'de
// kalir; firma uyeligi ve davetler bizim semada + SMTP e-postasiyla.
// GECIS DONEMI: iliskili tablolardaki firmaId'ler NULLABLE — mevcut veri
// kirilmasin; backfill sonrasi zorlamayi KOD yapar (sema degil).
// ─────────────────────────────────────────────────────────────────────
/// PLAN 5.8 — hesabin hangi yoldan kapandigi. Dort yolun dordunde de imha
/// sayaci baslar (K3); ayrim e-posta davranisi ve geri donus icindir.
enum KapatmaNedeni {
  /// Kullanici kendi kapatti. E-posta 30 gun hesapta; GIRIS ACIK (geri donus).
  kendi
  /// Yonetici sildi. E-posta 30 gun hesapta; giris kapali.
  yonetici
  /// Firma sahibi ekipten cikardi. E-posta HEMEN serbest (K1 istisnasi).
  ekiptenCikarildi
  /// Son sahip kapattigi icin firma kapandi. Uye durdurulur; sahip geri
  /// acarsa kendiliginden geri gelir.
  firmaKapandi
}

model Firma {
  id         String       @id @default(uuid())
  ad         String
  createdAt  DateTime     @default(now())
  /// PLAN 5.8 — firma imhasi ani (son sahip kapatinca dolar). Firmaya bagli
  /// icerik bu tarihten sonra silinir; SATIR ve KIMLIK kalir (fatura zinciri
  /// `Restrict` ile kilitli ve K4 sayesinde faturalar kendi kopyasini tasir).
  imhaTarihi DateTime?
  uyeler     User[]
  /// FAZ 7 F1b — ekip davetleri. `onDelete` YAZILMAZ: firma silinmez
  /// (yumusak silme kisiye ait), varsayilan Restrict dogru davranistir.
  davetler   FirmaDavet[]

  /// FAZ 7 F2b — firma sahibinin "firmamda herkes iki adimli giris
  /// kullansin" anahtari (§2.4). ⚠ YALNIZ PAROLAYLA girenlere uygulanir:
  /// sirket hesabiyla (kurumsal giris) gelen kisiye kod SORULMAZ — o kimlik
  /// dogrulamasi sirketin kendi saglayicisinda yapilmistir (§4.6, R1/E-4).
  mfaZorunlu Boolean @default(false)

  /// FAZ 7 F3b — firmanin kurumsal kimlik saglayicisi (firma basina TEK).
  kimlikSaglayici FirmaKimlikSaglayici?

  // ── ADIM 2 (28.08): FATURA KIMLIGI ────────────────────────────────────
  // e-Arsiv/e-Fatura kesimi icin gereken alanlar. HEPSI NULLABLE: kayit
  // akisi bunlari sormaz (surtunme yaratmaz), fatura kesimi sirasinda
  // eksikse fatura ELLE_MUDAHALE'ye duser ve yoneticiye bildirilir —
  // tahsilat akisi BLOKLANMAZ. Bkz. fatura.servisi.ts.
  //
  // `ad` ile `unvan` ayrimi kasitli: `ad` kayit akisinda e-postanin @
  // oncesinden turetilen GORUNEN addir ("acme"), `unvan` ise faturaya
  // yazilacak resmi unvandir ("Acme Muhendislik Ltd. Sti."). Fatura
  // servisi `unvan ?? ad` okur — unvan girilmemisse gorunen ad kullanilir.
  unvan         String?
  // Bildirim adresi. Dunning e-postalari once faturaEposta'ya, o yoksa
  // yetkiliEposta'ya gider (dunning.servisi.ts:295).
  yetkiliEposta String?
  faturaEposta  String?
  vergiNo       String?
  vergiDairesi  String?
  tcKimlikNo    String?
  faturaAdresi  String?
  il            String?
  ilce          String?
  /// FAZ 4.1 — plan listesindeki TEK gercekten eksik fatura alani (olculdu:
  /// digerlerinin 6/8'i 28.08'den beri vardi). Telefon HER satin almada
  /// musteriden ZORUNLU olarak aliniyor (ZORUNLU_MUSTERI_ALANLARI,
  /// satinalma.servisi.ts:120), iyzico'ya gonderiliyor ve DB'ye HIC
  /// yazilmadan atiliyordu — bu yuzden odeme formu her seferinde sifirdan
  /// doldurtuluyordu (on yuz bunu iki ayri yerde gerekce olarak yaziyor:
  /// abonelik/page.tsx:74 ve :113).
  telefon       String?

  // ── FAZ 4.3 — FIRMA LOGOSU (teklif ciktisi anteti icin) ───────────────
  // ⚠ NEDEN DISK DEGIL `Bytes`: backend servisinin docker-compose'da HIC
  // `volumes:` anahtari YOK (olculdu). Diske yazan bir cozum YERELDE calisir,
  // canlida her deploy'da SESSIZCE kaybolur — kullanici logosunu her surumde
  // yeniden yukler ve kimse fark etmez. Depodaki TEK calisan kalici dosya
  // deseni PostgreSQL `Bytes`'tir (QuoteFormat.fileBytes) ve o desen izleniyor.
  //
  // ⚠ MIME AYRI SAKLANIR: dosya adindan tahmin edilmez. Servis ucu
  // (`GET /firma/logo`) Content-Type'i buradan okur — quote-formats.controller
  // deseninin ayni.
  //
  // ⚠ Bu alanlar JSON yanitina KOYULMAZ: Prisma `Bytes`i Buffer dondurur ve
  // JSON'da base64'e cevrilir; `/auth/me` ya da `GET /firma` icine konursa her
  // sayfa acilisinda logo binary'si tasinir. Ikili veri AYRI uctan servis edilir.
  logoBytes Bytes?
  logoMime  String?

  abonelik Abonelik?
  /// A2 Blok 2 (24.09.2026) — yoneticinin paket degisimi onerileri.
  paketOnerileri PaketDegisimOnerisi[]
}

enum FirmaRol {
  sahip
  uye
}

/// 23.09.2026 — ALT KULLANICI IZINLERI ("Ekip & Izinler"). Kural tek yerde:
/// `backend/src/ozellik/firma/uye-izinleri.ts`. `sahip` icin liste OKUNMAZ
/// (her zaman tam yetkili). `firmaTeklifleri` kapaliysa kisi YALNIZ kendi
/// hazirladigi teklifleri gorur (Emre karari).
enum UyeIzni {
  excel
  dwg
  firmaTeklifleri
  kutuphane
}

model User {
  id                String     @id @default(uuid())
  email             String     @unique
  password          String
  role              Role       @default(user)
  status            UserStatus @default(active)
  tier              Tier       @default(core)
  // ADIM 1: firma uyeligi. nullable = henuz firmaya atanmamis eski kayit.
  firmaId           String?
  firma             Firma?     @relation(fields: [firmaId], references: [id])
  firmaRol          FirmaRol   @default(sahip)
  /// 23.09.2026 — alt kullanicinin ACIK modulleri (izin listesi, "allow-list").
  /// Varsayilan DORDU: ozellik gelmeden once her uye her seyi goruyordu;
  /// mevcut satirlar migration'da bu varsayilanla dolar, kimsenin erisimi
  /// kesilmez. Davetle katilan uye davetteki secimi tasir.
  izinler           UyeIzni[]  @default([excel, dwg, firmaTeklifleri, kutuphane])
  createdAt         DateTime   @default(now())
  /// YUMUSAK SILME. Dolu ise hesap silinmis sayilir: listede gorunmez, GIRIS
  /// YAPAMAZ ve mevcut token'i da gecersizdir (auth.service + jwt.strategy).
  /// Neden sert silme degil: Quote (:onDelete Cascade) ve UserLibrary de
  /// birlikte giderdi — kullanicinin butun teklifleri geri donusu olmadan.
  deletedAt         DateTime?
  /// FAZ 3.4 — e-posta dogrulamasi. Yeni kayitlar `false` baslar, dogrulama
  /// baglantisina tiklayinca `true` olur. GOC: mevcut hesaplar `true`
  /// isaretlendi (migration icinde) — aksi halde bugunku kullanicilar kendi
  /// urunlerinden bir gecede kilitlenirdi. Dogrulanmamis hesap GIRIS YAPAR,
  /// yalnizca uyari seridi gorur (girisi bloke etmek yeni kaydi kirar).
  emailVerified     Boolean    @default(false)
  /// FAZ 3.5 — parola en son ne zaman degisti. NULL = hic degismedi (eski
  /// hesap); bu durumda jwt.strategy'deki `iat` kapisi HICBIR token'i
  /// reddetmez. Parola degisince/sifirlanınca now() yazilir ve o andan ONCE
  /// imzalanmis (calinmis olabilecek) token'lar reddedilir — durumsuz JWT'de
  /// parola degisiminin eski oturumlari oldurmesinin tek yolu budur.
  passwordChangedAt DateTime?
  /// FAZ 4.1 — KISI alanlari. Hepsi OPSIYONEL: zorunlu yapmak mevcut kayit
  /// akisini kirardi (RegisterDto bugun yalniz email+password aliyor) ve
  /// Firma'nin butun fatura alanlarinin nullable olmasiyla ayni gerekce —
  /// kayit surtunmesi yaratmadan, profil ekraninda sonradan doldurulur.
  ///
  /// ⚠ `unvan` BILEREK YOK: `Firma.unvan` zaten RESMI FIRMA UNVANI. Ayni adi
  /// User'da "kisi gorev unvani" anlaminda kullanmak, iki farkli seyi tek
  /// isimle adlandirmak olurdu (bu depoda `firmaId`'nin iki farkli seye
  /// isaret etmesi tam olarak boyle bir karisiklik uretiyor).
  ad                String?
  soyad             String?
  telefon           String?

  // ── FAZ 5.3 — ONAY KAYITLARI (uyusmazlikta ISPAT YUKU BIZDE) ──────────
  /// Kullanim kosullari / uyelik sozlesmesi onayinin ZAMANI. Boolean DEGIL
  /// tarih: "onayladi mi" sorusunun cevabi mahkemede yetmez, "NE ZAMAN ve
  /// HANGI METNI" onayladigi sorulur.
  sozlesmeOnayiAt    DateTime?
  /// Onaylanan metnin surumu. Metin degisince eski onay o metni KAPSAMAZ;
  /// surum tutulmazsa hangi metne onay verildigi geri getirilemez.
  sozlesmeSurumu     String?
  /// TICARI ILETI (pazarlama) izni — AYRI ve ONCEDEN ISARETSIZ olmak
  /// ZORUNDA (ETK/IYS). Sozlesme onayiyla birlestirmek izni gecersiz kilar.
  /// NULL = izin verilmedi. Bugun hicbir pazarlama gonderimi YOK; alan
  /// izin ALINMADAN gonderim yapilamasin diye simdiden duruyor.
  ticariIletiOnayiAt DateTime?

  /// ── FAZ 5.5 — HESAP KAPATMA ──────────────────────────────────────────
  /// Kapatma aninda `email` alani anonimlestirilir ve ORIJINALI buraya
  /// tasinir. Neden: `email` @unique — kapatilan hesabin adresi kilitli
  /// kalirsa kullanici AYNI adresle geri donemez ("Email already in use")
  /// ve bunu ne kendisi ne yonetici geri alabilir (olculdu: `deletedAt`i
  /// null'a ceviren TEK BIR SATIR yok). Adres burada saklandigi icin
  /// denetim/ispat izi de kaybolmaz.
  kapatilanEposta String?

  /// ── PLAN 5.8 — VERI IMHASI (21.09.2026) ──────────────────────────────
  /// IMHA ANI. `deletedAt + 30 gun`. Gunluk imha isi YALNIZ bu alana bakar,
  /// `deletedAt`e DEGIL. Neden ayri alan: bu turdan ONCE kapatilmis hesaplara
  /// "verileriniz kalir" denmisti; onlarin `imhaTarihi` bos oldugu icin
  /// hicbiri sessizce silinmez (olculdu 21.09: canlida 0 kapali hesap).
  imhaTarihi DateTime?

  /// HANGI YOLDAN KAPANDI. Dort kapatma yolu bugun AYNI `kapatmaVerisi()`ni
  /// yaziyordu ve ayirt edilemiyordu (olcum O1). K1 istisnasi buna bagli:
  /// yalnizca `ekiptenCikarildi` olanin e-postasi HEMEN serbest kalir —
  /// ayrilmayi o secmedi, baska bir firmaya katilabilmeli. Digerlerinde
  /// e-posta 30 gun hesapta durur ki musteri ayni adresle geri donebilsin.
  kapatmaNedeni KapatmaNedeni?

  /// ── FAZ 7 F2b — IKI ADIMLI GIRIS (TOTP, §2.4) ────────────────────────
  /// TOTP sirri. AES-256-GCM, `kimlik-sifreleme.ts` bicimi
  /// `v1.<iv>.<tag>.<sifreli>` (base64url), ek dogrulama verisi (AAD)
  /// `mfa:<userId>`. ⚠ Duz sir HICBIR yerde saklanmaz ve kurulum yanitindan
  /// sonra HICBIR ucta bir daha donmez.
  mfaSirriSifreli       String?
  /// Dolu = iki adimli giris ACIK (tarih = acildigi an). TEK dogru kaynak:
  /// ayri bir `mfaAcik` boolean'i tutulsaydi ikisi gunun birinde ayrisirdi.
  mfaAcikAt             DateTime?
  /// R1 (Emre E-4): 'kisisel' (kisi kendi acti ya da "sirket girisinde de
  /// sor" dedi) · 'zorunlu-firma' · 'zorunlu-yonetici'. `mfaAcikAt` ile
  /// BIRLIKTE yazilir, kapatilinca null. Kurumsal giriste YALNIZ 'kisisel'
  /// kod sorar (§4.6) — sirket kendi kimlik saglayicisindan sorumludur.
  mfaKaynagi            String?
  /// Son KABUL EDILEN 30 sn'lik adim (floor(unix/30)). Ayni ya da onceki
  /// adimin kodu REDDEDILIR (tekrar saldirisi). Int32 yil ~3000'e yeter.
  mfaSonAdim            Int?
  /// Kurulum baslatildi, henuz kodla onaylanmadi (15 dk gecerli). Onaya
  /// kadar `mfaSirriSifreli`ye DOKUNULMAZ: yarim kurulum acik bir hesabin
  /// sirrini bozamaz.
  mfaBekleyenSirSifreli String?
  mfaBekleyenAt         DateTime?
  /// Art arda yanlis kod sayaci; dogru kodda 0. 20'de kilit. IP'den
  /// BAGIMSIZ (kisi kovasi) — IP degistiren saldirgana karsi asil kapi.
  mfaHataSayaci         Int               @default(0)
  mfaKilitliAt          DateTime?
  mfaKurtarmaKodlari    MfaKurtarmaKodu[]

  /// ── 23.09.2026 — YONETICI GIRISINDE E-POSTA KODU (Emre karari) ───────
  /// Emre TOTP kurulumunu tamamlayamadi ("bu yontemle giris yapamiyorum ve
  /// cok zor geldi") ve yontemin degismesini istedi. 21.09'da e-posta OTP
  /// bir kez REDDEDILMISTI; karar BILEREK geri alindi ve gerekcesi kendisine
  /// yeniden soylendi: parola sifirlama da ayni kutudan yapiliyor ve MFA'yi
  /// temizlemiyor, yani yonetici hesabinin guvenligi artik POSTA KUTUSUNUN
  /// guvenligi kadardir. Karar musteriye aittir.
  ///
  /// ⚠ KOD DUZ SAKLANMAZ: `scrypt` ozeti (parola alanlariyla ayni disiplin).
  /// Veritabanini okuyan biri gecerli kodu OKUYAMAZ.
  mfaEpostaKoduOzeti    String?
  /// Kodun uretildigi an. Gecerlilik 10 dk (`EPOSTA_KODU_GECERLILIK_SN`).
  /// ⚠ AYRI ALAN: `mfaBekleyenAt` TOTP kurulumunun damgasidir; ikisini tek
  /// alanda tutmak, bir yolun otekinin suresini sifirlamasi demekti.
  mfaEpostaKoduAt       DateTime?
  /// Son gonderim ani — yeniden gonderme kisiti (60 sn) buradan olculur.
  /// `mfaEpostaKoduAt` ile AYNI DEGIL: yeniden gonderim YENI kod uretir,
  /// ama kisit gonderime bakar, koda degil.
  mfaEpostaSonGonderim  DateTime?

  /// FAZ 7 F3b — false: hesap KURUMSAL GIRISLE acildi, bilinen parolasi yok
  /// (`password` kullanilamaz rastgele ozet tasir — nullable YAPILMADI, yoksa
  /// `bcrypt.compare(x, null)` 500 uretirdi, §2.6). Parola sifirlama basarili
  /// olunca true olur. Uc kapiyi besler: giris yalniz kurumsal · hesap kapatma
  /// parola yerine `authAt` kaniti · parola degistirme 400 `PAROLA_YOK`.
  parolaTanimli Boolean              @default(true)
  disKimlikler  KullaniciDisKimlik[]

  library                  UserLibrary[]
  brandLibraries           UserBrandLibrary[]
  libraryLists             LibraryList[]
  laborFirms               LaborFirm[]
  quotes                   Quote[]
  subscriptions            UserSubscription[]
  quoteFormats             QuoteFormat[]
  parolaSifirlamaTokenlari PasswordResetToken[]
  epostaDogrulamaTokenlari EmailVerificationToken[]

  @@index([deletedAt])
  /// FAZ 7 F1b — KISI SINIRI SIRASI (`uyelik-kurallari.ts` §3.12). Her
  /// kimlikli istekte "benden once kac etkin hesap var" sayilir; sorgu
  /// `firmaId` + `firmaRol` + `createdAt` uzerinden kosar. Indekssiz her
  /// istekte firma basina tam tarama olurdu.
  @@index([firmaId, firmaRol, createdAt])
}

/// ═══════════════════════════════════════════════════════════════════════════
///  FAZ 3.3 — PAROLA SIFIRLAMA TOKEN'I
/// ═══════════════════════════════════════════════════════════════════════════
///
/// ⚠ TOKEN BURADA DUZ METIN TUTULMAZ — yalniz SHA-256 OZETI (`tokenHash`).
/// Gerekce olculmus bir gercek: bu deponun yedekleri 07.09'a kadar sunucu
/// disina DUZ METIN cikiyordu (0.9b ile sifrelendi) ve `.env`/dokum sizintisi
/// bu projenin gecmisinde somut bir risk oldu. Duz metin tutulan bir sifirlama
/// token'i, sizan bir dokumde DOGRUDAN HESAP DEVRALMA demektir: saldirgan
/// token'i okur, /reset-password'e verir, parolayi degistirir.
/// Ozet tutuldugunda sizan dokum ise yaramaz — ozetten token uretilemez.
///
/// TEK KULLANIMLIK: `usedAt` damgalanir. SURE: 1 saat (`expiresAt`).
/// Yeni token uretilince ayni kullanicinin bekleyen digerleri gecersizlesir
/// (servis `usedAt` damgalar) — boylece e-posta kutusundaki eski baglantilar
/// birikmez.
model PasswordResetToken {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256(token). @unique: dogrulama TEK sorguyla yapilir, tarama yok.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// FAZ 3.4 — E-POSTA DOGRULAMA TOKEN'I.
/// Sekil PasswordResetToken'dan KOPYALANDI (ayni hash'leme kurali, ayni
/// tek-kullanimlik sozlesmesi) — yeni bir usul ICAT EDILMEDI. Tek fark sure:
/// dogrulama baglantisi 24 saat yasar (kullanici kaydolup e-postasini ertesi
/// gun acabilir; sifirlama ise 1 saat cunku saldiri penceresi dardir).
model EmailVerificationToken {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// ═══════════════════════════════════════════════════════════════════════════
///  FAZ 7 F2b — IKI ADIMLI GIRIS KURTARMA KODU (§2.4)
/// ═══════════════════════════════════════════════════════════════════════════
///
/// Telefon kaybolunca hesaba girmenin TEK kullanici tarafli yolu. 10 kod
/// uretilir, her biri TEK kullanimliktir (`kullanildiAt` damgalanir).
model MfaKurtarmaKodu {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// ⚠ bcrypt(10) — SHA-256 DEGIL. `token-ozet.ts`in "256 bit rastgele →
  /// hizli ozet yeter" gerekcesi BURADA GECERSIZ: kurtarma kodu 10 karakter
  /// Crockford base32 (~50 bit) ve 2^50 SHA-256 sizan bir dokumden kaba
  /// kuvvetle cozulebilir. bcrypt kaba kuvveti pratikte olanaksiz kilar.
  kodOzeti     String
  kullanildiAt DateTime?
  olusturuldu  DateTime  @default(now())

  /// `onDelete: Cascade` bilincli: kullanici SERT silinmez (src'de
  /// `user.delete` yok), token tablolariyla ayni sozlesme.
  @@index([userId, kullanildiAt])
}

// ESLESME HAFIZASI (PRD Adim 8) — belirsiz satirda kullanicinin sectigi urunu
// hatirlar. Imza = belirsizligin parmak izi (brandId|olcu|tip|cins-ipucu).
// Kullanici bazli: bir firmanin tercihi digerine dayatilmaz. ML/embedding YOK —
// duz alias tablosu; ayni imza ikinci kez gelince secici atlanir, 'oneri' dolar.
model EslesmeHafizasi {
  id             String   @id @default(uuid())
  userId         String
  firmaId        String? // ADIM 1 gecis: null=atanmamis; suzgecler backfill sonrasi buna doner
  imza           String
  // Secilen KUTUPHANE urununun ADI (id degil — kutuphane satiri silinip
  // yeniden aktarilabilir; ad ile guncel kutuphanede tekrar bulunur).
  secilenAd      String
  secimSayisi    Int      @default(1)
  sonSecimTarihi DateTime @updatedAt

  @@unique([userId, imza])
  @@index([firmaId])
}

// TERMINOLOJI SOZLUGU (PRD v1.1 §5) — sektorel terim/baslik → kanonik malzeme.
// "SPRINK HATTI BORULARI" basligi kutuphanedeki "Siyah Celik Boru"ya bu tablo
// uzerinden cozumlenir. Seed kayitlar sistemle gelir (TR+EN), kullanici kendi
// alias'larini ekleyebilir (S3); seed silinmez, pasife alinir.
model TerminologyAlias {
  id          String   @id @default(uuid())
  // null = sistem geneli seed; dolu = kullaniciya (hesaba) ozel
  userId      String?
  firmaId     String? // ADIM 1 gecis: null=atanmamis; suzgecler backfill sonrasi buna doner
  // NORMALIZE edilmis terim ("sprink hatti") — contains mantigiyla eslesir,
  // en uzun eslesen alias kazanir (S2)
  alias       String
  // Kanonik malzeme anahtari ("siyah_celik_boru", "hdpe_pe100_boru")
  canonical   String
  // Cins ipuclari (KIND_TAGS uyumlu: celik/ppr/hdpe/pe/pvc...) — tie-break,
  // sert filtre degil
  kinds       String[] @default([])
  // Ima edilen malzeme tipi ('boru' vb.) — tip belirsizligini cozer
  impliedType String?
  // Cap cevrim sinifi: 'steel' | 'plastic' | null (belirsiz)
  sizeClass   String?
  // Bu islevsel kelimeden uretilen ve elemeye girmemesi gereken tag'ler
  stripTags   String[] @default([])
  active      Boolean  @default(true)
  createdBy   String   @default("seed") // 'seed' | 'user'
  createdAt   DateTime @default(now())

  @@unique([userId, alias])
  @@index([userId])
  @@index([firmaId])
}

// MARKA → MALZEME TIPI (PRD §10.4, D2/P1) — marka adindaki uretici deseni
// malzeme sinifini belirler: Cayirova → celik (DN↔inc), Kalde → PPR (DN=mm).
model BrandMaterialType {
  id        String   @id @default(uuid())
  userId    String? // null = seed; dolu = kullanici ekledi
  firmaId   String? // ADIM 1 gecis: null=atanmamis; suzgecler backfill sonrasi buna doner
  // NORMALIZE uretici deseni ("cayirova") — marka adinda contains aranir,
  // "X veya muadili" kaliplarini da yakalar
  pattern   String
  kinds     String[] @default([])
  sizeClass String // 'steel' | 'plastic'
  active    Boolean  @default(true)
  createdBy String   @default("seed")
  createdAt DateTime @default(now())

  @@unique([userId, pattern])
  @@index([userId])
  @@index([firmaId])
}

// Kullanicinin kendi marka kutuphanesi — ExcelGrid gorunumu icin sheets JSON
// UserLibrary (satir bazli, matching icin) ile paralel calisir
model UserBrandLibrary {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  firmaId   String? // ADIM 1 gecis: null=atanmamis; suzgecler backfill sonrasi buna doner
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId   String
  sheets    Json // ExcelGrid raw sheets yapisi (multi-sheet, grup basliklari, merge cells)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ADIM 1 (28.08): tekillik KISI'den FIRMA'ya tasindi. Kutuphane firmaya
  // ait; tekillik kisi bazli kalsaydi ayni firmanin iki uyesi AYNI marka
  // icin iki sheet kaydi acar, firma gorunumu markayi CIFT gosterirdi.
  // Bugun cakisma imkansiz (her firmada tek uye) — gecis simdi guvenli.
  @@unique([firmaId, brandId])
  @@index([userId])
  @@index([firmaId])
}

model UserSubscription {
  id        String            @id @default(uuid())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  firmaId   String? // ADIM 1 gecis: null=atanmamis; suzgecler backfill sonrasi buna doner
  level     PackageLevel
  scope     SubscriptionScope
  startsAt  DateTime          @default(now())
  endsAt    DateTime?
  active    Boolean           @default(true)
  createdAt DateTime          @default(now())

  @@unique([userId, level, scope])
  @@index([userId])
  @@index([firmaId])
}

model Brand {
  id             String             @id @default(uuid())
  name           String             @unique
  logoUrl        String?
  discipline     String             @default("mechanical") // 'mechanical' | 'electrical'
  // KISISEL MARKA IZOLASYONU (24.08): kutuphane "Marka Ekle" akisi Brand'i
  // global tabloya yazmak zorunda (ad @unique + eslestirme/teklif FK'leri) ama
  // o marka HAVUZUN MALI DEGILDIR. false = kullanicinin kisisel kapsayicisi —
  // GET /brands (havuz + admin panel) listelemez; kutuphane uclari (findLibrary
  // Brands, getBrandLists, findOne) etkilenmez. Admin ayni adla havuz markasi
  // acmak isterse brands.service.create kisisel markayi havuza TERFI ettirir.
  isGlobal       Boolean            @default(true)
  priceLists     PriceList[]
  materialPrices MaterialPrice[]
  userLibrary    UserLibrary[]
  userLibraries  UserBrandLibrary[]
  libraryLists   LibraryList[]
  quoteItems     QuoteItem[]
  productIndex   ProductIndex[]
}

model PriceList {
  id            String          @id @default(uuid())
  name          String
  brand         Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId       String
  // ProductIndex.ownerUserId'nin LISTE-DUZEYI ikizi (24.08): null = havuz
  // listesi (admin yukledi); dolu = kutuphane akisinin actigi KISISEL liste
  // (createManualBrand / addRowsToBrandList her eklemede bir PriceList acar —
  // ProductIndex.priceListId zorunlulugu). Havuz/admin gorunumleri ve
  // kutuphaneye aktarim kaynagi ownerUserId=null suzer; sahibinden baskasi
  // (admin dahil) icerigini okuyamaz.
  ownerUserId   String?
  // ADIM 1 (28.08): ownerUserId'nin FIRMA ikizi. Kisisel liste artik firmanin;
  // ayni firmanin uyesi de okuyabilmeli (kutuphane firmaya ait). null = havuz.
  ownerFirmaId  String?
  createdAt     DateTime        @default(now())
  items         MaterialPrice[]
  userLibraries UserLibrary[]
  productIndex  ProductIndex[]

  @@index([ownerFirmaId])
}

// ════════════════════════════════════════════════════════════════════
// URUN INDEKSI (Indeksli + Ad-Kilitli TEK Motor — Faz 1)
//
// Havuzun yeni gercegi. Fiyat listesi YUKLENIRKEN her satir buraya
// kolonlardan indekslenir; eslestirme motoru YALNIZ burayi okur ve
// metinden aile TAHMIN ETMEZ.
//
// Neden ayri tablo: Material.name @unique + upsert, ayni ad/cins/capta
// farkli BAGLANTI SEKLI'ndeki iki urunu tek kayda eziyordu (kod kendi
// yorumunda bunu "veri kaybi" diye isaretlemis: admin.service.ts:580).
// Bu kisit K7'nin ("ayni kod farkli sayfada farkli fiyat = IKI kayit")
// tanimiyla dogrudan celisiyor. Cozmeye calismak yerine kimligi ADA
// degil DOSYA SATIRINA baglıyoruz (rowKey).
//
// Material/MaterialPrice SILINMEZ — yalnizca eslestirme yolundan cikar.
// ════════════════════════════════════════════════════════════════════
model ProductIndex {
  id           String     @id @default(uuid())
  brand        Brand      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId      String
  priceList    PriceList? @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  priceListId  String?
  // null = havuz (admin yukledi); dolu = kullanicinin kendi manuel satiri
  ownerUserId  String?
  ownerFirmaId String? // ADIM 1 gecis: null=havuz; dolu=firmanin kendi manuel satiri

  // ── 11 KOLON BIREBIR (kaynak sadakati — hicbiri dusmez) ──────────
  kategori  String? // Kategori (PDF Bolumu)
  ad        String // Malzeme Adi         ← ZORUNLU (bucket'in kaynagi)
  cins      String? // Malzeme Cinsi
  baglanti  String? // Baglanti Sekli      ← bugun TAMAMEN dusuyordu
  capRaw    String? // Cap
  boyMm     Float? // Boy (mm)            ← bugun TAMAMEN dusuyordu
  birim     String? // Birim
  price     Float // Birim Fiyat
  // Z4: cevrim YOK — orijinal para birimi saklanir, TRY'ye yalniz teklif aninda
  currency  String  @default("TRY")
  urunKodu  String? // Urun Kodu (Art.No)  ← bugun okunup ATILIYORDU
  not       String? // Not                 ← bugun TAMAMEN dusuyordu
  sheetName String?
  sourceRow Int     @default(0)
  sortOrder Int     @default(0)
  // Role oturmayan ek sutunlar (Y2: sutun dusurulmez)
  extra     Json?

  // ── ON-HESAP (YALNIZ yukaridaki kolonlardan turetilir) ───────────
  // Seviye1 AILE — sert kilit: 'kompansator' → vana/hortum ASLA aday olamaz
  adSlug         String
  // Seviye2 AD BUCKET — alt-ad: 'omega v flex dilatasyon kompansatoru'
  adBucket       String
  // Ad kolonunun token'lari — teklifin adTokens'i bunun ALT KUMESI olmali (K1)
  adTokens       String[] @default([])
  cinsNorm       String?
  cinsTokens     String[] @default([])
  // HAM normalize deger — KANONIKLESTIRILMEZ. extractConnection("döner
  // flanşlı") → 'flans' doner ve "döner"i KAYBEDER; oysa K3'un cevap
  // secenekleri tam olarak "döner flanşlı" / "sabit flanşlı"dir. Ayrica
  // extractConnection "kaynak boyunlu"yu hic tanimiyor (null) — ham deger
  // o kolonu da kurtarir. Eslestirme baglantiTokens ALT-KUMESI ile yapilir.
  baglantiNorm   String?
  baglantiTokens String[] @default([])
  sizeClass      String   @default("unknown")
  // S5 MALZEME ETIKETLERI (pvc/pp/ppr/pe/celik/pirinc/paslanmaz...): sizeClass
  // yalniz steel|plastic|unknown ayrimi yapar ve PVC ile PP'yi AYIRT EDEMEZ.
  // Sozluk bu bilgiyi zaten tasiyordu (TerminologyAlias.kinds), urun tarafinda
  // bakilacak alan yoktu. BOS DIZI = "cozulemedi", suclama DEGIL.
  malzemeler     String[] @default([])
  // S4: aile YALNIZ kategori basligindan cozuldu (ad hicbir aile vermedi).
  // Kategori fallback'i kapsamayi kazandirdi, KALIR — ama bu bayrak tahmine
  // dayali yollari (capsiz istisnasi, ad-gevsetme, capraz-marka onerisi)
  // o kayda kapatir. Varsayilan false: eski/bilinmeyen kayit FRENSIZ kalir.
  aileZayif      Boolean  @default(false)
  // ON-HESAP esdegerlik kumesi: teklifteki 2" ile kutuphanedeki DN50 INDEKS
  // duzeyinde bulusur — sorgu aninda cevrim aranmaz (conversion.ts DOKUNULMAZ,
  // yalnizca yazma aninda BIR KEZ calistirilir).
  capTags        String[] @default([])
  capNorm        String?
  boyTag         String?
  displayName    String
  // K7 + idempotent yeniden yukleme kimligi (bkz. product-index.ts)
  rowKey         String
  indexVersion   Int      @default(1)
  // adSlug cozulemedi → eslestirmeye ADAY OLAMAZ (PRD 2A: "sessizce yanlis
  // eslesmektense gorunur sekilde eksik kal"). Admin dropdown'undan duzeltilir.
  belirsiz       Boolean  @default(false)

  userLibrary UserLibrary[]

  // Idempotent yeniden yukleme: ayni satir → ayni rowKey → UPDATE, id KORUNUR
  // → UserLibrary.productIndexId FK'si ayakta kalir → ISKONTO HIC KAYBOLMAZ.
  @@unique([priceListId, rowKey])
  @@index([brandId, adSlug])
  @@index([adSlug, adBucket])
  @@index([urunKodu])
}

model Material {
  id             String          @id @default(uuid())
  name           String          @unique
  unit           String?
  category       String?
  listPrice      Float?
  isGlobal       Boolean         @default(true)
  tags           String[]        @default([])
  normalizedName String?
  materialType   String?
  materialPrices MaterialPrice[]
  userLibrary    UserLibrary[]

  @@index([materialType])
}

model MaterialPrice {
  id          String     @id @default(uuid())
  material    Material   @relation(fields: [materialId], references: [id], onDelete: Cascade)
  materialId  String
  brand       Brand      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId     String
  priceList   PriceList? @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  priceListId String?
  price       Float
  // Z4 (Fiyat Bicimi Duzeltme Talebi): fiyat ORIJINAL para birimiyle saklanir
  // ("TRY" | "USD" | "EUR"). Ice aktarimda cevrim YAPILMAZ; cevrim yalniz
  // teklif asamasinda o anki TCMB kuruyla yapilir.
  currency    String     @default("TRY")
  // ── KAYNAK SADAKATI (Duzeltme Talebi Y1/Y2/Y5): yuklenen dosyanin yapisi
  // liste-kalemi seviyesinde BIREBIR saklanir. Material global-unique kalir;
  // gorunum ve yapi bu alanlardan beslenir.
  // Dosyadaki kategori basligi ("Esnek Metal Hortum / Orgulu Hortum")
  kategori    String?
  // MALZEME CINSI sutunu (bossa null — miras tagging'de, veri bozulmaz)
  cins        String?
  // CAP sutunu (ayri alan — esletirme tag'lerine de katilir, E6)
  cap         String?
  // MALZEME ADI hucresi BIREBIR (Material.name benzersizlik icin birlesik olabilir)
  adRaw       String?
  // BIRIM hucresi birebir
  birimRaw    String?
  // Kaynak satir sirasi (Y5: sistem yeniden siralamaz)
  sortOrder   Int        @default(0)
  // Role oturmayan ek sutunlar { "Kolon Adi": "deger" } (Y2: sutun dusurulmez)
  extra       Json?

  @@unique([materialId, brandId, priceListId])
}

model UserLibrary {
  id                String     @id @default(uuid())
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  firmaId           String? // ADIM 1 gecis: null=atanmamis; suzgecler backfill sonrasi buna doner
  material          Material?  @relation(fields: [materialId], references: [id])
  materialId        String?
  materialName      String?
  brand             Brand      @relation(fields: [brandId], references: [id])
  brandId           String
  customPrice       Float?
  discountRate      Float?
  listPrice         Float?
  // Z4: listPrice/customPrice'in para birimi — havuzdan aktarimda MaterialPrice
  // .currency kopyalanir; eslestirme teklif aninda TRY'ye cevirir.
  currency          String     @default("TRY")
  // ── L1/L3 (Kutuphane Aktarim Sadakati): havuzdaki yapi BIREBIR tasinir.
  // Kategori basligi (grup bantlari + eslestirme baglami)
  kategori          String?
  // Cins/Cap ayri sutunlar (havuz gorunumuyle ayni alanlar)
  cins              String?
  cap               String?
  // Kaynak metin birebir (Y3 ikizi)
  adRaw             String?
  // Kaynak satir sirasi (grup ici siralama — sistem alfabetik dayatmaz)
  sortOrder         Int        @default(0)
  unit              String?
  sourcePriceList   PriceList? @relation(fields: [sourcePriceListId], references: [id], onDelete: SetNull)
  sourcePriceListId String?
  // Sarf malzemesi / ekipman icin ek teknik ozellikler. Serbest key-value JSON.
  // Ornek: { "power": "24 kW", "capacity": "100 m3/h", "voltaj": "220V" }
  // DWG workspace'te INSERT (ekipman) noktasina atanan malzemenin guc/kapasite
  // gibi bilgileri burada tutulur, hesaplamaya/cikti'ya dahil edilir.
  specs             Json?
  // "ekipman" | "boru" | "fitting" | null — DWG equipment popup filtre icin
  category          String?

  // ── URUN INDEKSI BAGI (Faz 1 — additive, nullable) ──────────────
  // Urun YAPISI indekse ait, EKONOMI (customPrice/discountRate) kullaniciya.
  // Denormalizasyon YOK: yapiyi buraya kopyalarsak liste yeniden yuklendiginde
  // kutuphane sessizce eskir. Tek gercek ProductIndex'te durur.
  //
  // ── onDelete: SetNull (B-1, 04.08 — eskiden Cascade idi) ─────────
  // TAKAS: bag koparsa satir YASAR ama YAPISIZ kalir. Cascade'de tersiydi —
  // indeks satiri silinince kullanicinin kutuphane satiri da ucuyordu, yaninda
  // discountRate/customPrice ile birlikte. Yani admin bir fiyat listesini
  // silince (priceList.delete → ProductIndex CASCADE → UserLibrary CASCADE)
  // kullanicinin PAZARLIKLA aldigi iskontosu sessizce yok oluyordu.
  //
  // NEDEN BU TARAF: kullanicinin ekonomisi > yapisal butunluk. Yapi
  // GERI URETILEBILIR (fiyat listesi yeniden yuklenir, reindex kosar,
  // matching.service.hazirlaPool bagsiz satiri istek aninda materialName'den
  // yeniden indeksler); kullanicinin iskontosu GERI URETILEMEZ — o veri
  // kullanicinin kendi ticari bilgisidir, hicbir yerden geri gelmez.
  //
  // Bu ayni tablodaki sourcePriceList (:334 SetNull) kuraliyla da tutarli:
  // artik satira bagli iki FK de "bag kopar, satir yasar" diyor. Oncesinde
  // ayni satirda biri koruyucu biri oldurucu iki celiskili kural vardi.
  //
  // TUKETICILER NULL'A HAZIR (04.08 okundu, degistirilmedi):
  //   library.service.ts:572-575  → item.product?.X ?? null
  //   matching.service.ts:145     → if (li.productIndexId && li.product) …
  //                                 else → manuelUrunIndeksle (metinden)
  product        ProductIndex? @relation(fields: [productIndexId], references: [id], onDelete: SetNull)
  productIndexId String?

  // ── KUTUPHANE LISTE BAGI (07.08 — iscilikteki "ilave sayfa"nin ikizi) ──
  // null = varsayilan liste (lazy goc: library.service.getBrandLists ilk
  // acilista null satirlari varsayilan LibraryList'e baglar). SetNull: liste
  // silme akisi satirlari ZATEN acikca siler; bu yalniz emniyet kemeri.
  libraryList   LibraryList? @relation(fields: [libraryListId], references: [id], onDelete: SetNull)
  libraryListId String?

  // Motorun ANA sorgusu: userLibrary.findMany({ where: { userId, brandId } })
  // — bugune kadar bu tabloda HIC index yoktu (full scan).
  @@index([userId, brandId])
  @@index([productIndexId])
  @@index([libraryListId])
  @@index([firmaId])
}

// ── MALZEME KUTUPHANESI FIYAT LISTESI (07.08) ─────────────────────────
// Iscilikteki LaborPriceList'in kutuphane ikizi: bir markanin satirlari
// sekmelere ("sayfa") bolunur. ESLESTIRME MOTORUNA GORUNMEZ — motor
// UserLibrary'yi userId+brandId ile okur (tum listelerin BIRLESIMI),
// iscilikle ayni semantik (bulkMatchLabor da firmaId ile tum listeleri okur).
model LibraryList {
  id         String        @id @default(uuid())
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  firmaId    String? // ADIM 1 gecis: null=atanmamis; suzgecler backfill sonrasi buna doner
  brand      Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId    String
  name       String
  uploadedAt DateTime      @default(now())
  items      UserLibrary[]

  @@index([userId, brandId])
  @@index([firmaId])
}

model Quote {
  id           String      @id @default(uuid())
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  firmaId      String? // ADIM 1 gecis: null=atanmamis; suzgecler backfill sonrasi buna doner
  title        String?
  sheets       Json? // Multi-sheet Excel raw state (SheetData[]), null = legacy tek-sheet quote
  originalFile Bytes? // Orijinal Excel dosya binary'si — indirirken fiyatlar uzerine yazilir
  originalName String? // Orijinal dosya adi (orn. "SAHINKUL KESIF OZETI.xlsx")
  createdAt    DateTime    @default(now())
  /// FAZ 4.5 — teklifin ne zaman revize edildigi hicbir yerde yoktu; liste
  /// siralamasi `createdAt`e mahkumdu. "Ayni teklifin 3-4 revizyonu normaldir"
  /// senaryosunda son dokunulani gormek sart.
  /// @default(now()) mevcut satirlar icin gerekli (aksi halde NOT NULL kolon
  /// eklenemez); yeni yazmalarda Prisma @updatedAt'i kendisi gunceller.
  updatedAt    DateTime    @default(now()) @updatedAt
  items        QuoteItem[]

  // ── PRD Teklif Formatim (v2.1) ────────────────────────────────────
  // Teklif kimligi: ILK dis aktarimda atanir (MP-<yil>-<sira>), sonra sabit.
  quoteNo         String?
  // Rev sayaci: 0 = hic aktarim yok; ilk aktarim Rev.01 (T10)
  rev             Int           @default(0)
  // SORUN 16 (KH8, 27.07): goruntuleme para birimi teklifle KAYDEDILIR —
  // detay sayfasi ayni birimle acilir. Kur+tarih kayit anindaki ARSIV
  // degeridir (goruntuleme canli TCMB kuruyla yapilir, etikette gosterilir).
  displayCurrency String        @default("TRY")
  displayRate     Float?
  displayRateDate String?
  // 13.08: teklifin DILI de para birimi gibi KAYDEDILIR ('tr' | 'en').
  // Neden sart: ceviri satirlara kalici yaziliyordu ama "bu teklif Ingilizce"
  // bilgisi HICBIR YERDE durmuyordu. Detay sayfasi her acilista dili 'tr'
  // varsayiyor, dolayisiyla export'a dil GITMIYOR ve musteriye satirlari
  // Ingilizce ama basliklari/birimleri TURKCE bir dosya gidiyordu.
  displayLanguage String        @default("tr")
  // Teklif bilgileri (kapak yer tutuculari — teklif ekraninda girilir)
  // ⚠ OLCULDU (08.09): sema + yazan uc (PATCH /quotes/:id/info) + okuyan
  // export motoru ({{MUSTERI}} {{PROJE}} {{HAZIRLAYAN}} {{GECERLILIK}}) UCU DE
  // calisiyordu, ama bu dort kutu 06.08'de `d0dc27d` ile EKRANDAN KALDIRILMIS
  // ve geri konmamisti — yani sutunlar pratikte DAIMA null'di. "Mekanizma var,
  // cagiran yok" tuzaginin bu depodaki yedinci ornegi. Ingilizce adli
  // (customerName/projectName) IKIZ SUTUN ACMAYIN: quotes.service.ts'te o
  // adlari okuyan olu bir satir vardi, ikiz sutun onu canlandirip ayni bilgi
  // icin iki kismi dolu kaynak uretirdi.
  musteri         String?
  proje           String?
  hazirlayan      String?
  gecerlilik      String?
  /// FAZ 4.5/4.6 — SATIS DURUMU. Planin teklif alanlari listesindeki TEK
  /// gercekten eksik olan sey (digerlerinin 5/6'si zaten vardi).
  ///
  /// ⚠ DEGER ADI `TASLAK` DEGIL `HAZIRLANIYOR`: bu depoda `taslak` ZATEN
  /// baska bir sey demek — sessionStorage'da tutulan YARIM DUZENLEME
  /// (frontend/ozellik/teklif/taslak.ts, TASLAK_ANAHTARI). Ayni kelimeyi
  /// satis durumu icin de kullanmak iki kavrami karistirirdi.
  durum           TeklifDurumu  @default(HAZIRLANIYOR)
  // Secili format (null = kullanicinin varsayilani, o da yoksa yerlesik sade)
  format          QuoteFormat?  @relation(fields: [formatId], references: [id], onDelete: SetNull)
  formatId        String?
  // T13/T14: onizleme duzenlemeleri — YALNIZ bu teklifin ciktisina islenir,
  // ana format DEGISMEZ. {sheetKey: {cellAddr: {value, manual: true}}}
  exportOverrides Json?
  exports         QuoteExport[]

  // ARINMA Faz 3: kullanici-basina teklif listesi (findMany{userId}) en sik
  // sorgu — indexsiz full-scan'di ("olcek hep binlerce eszamanli" kurali).
  @@index([userId])
  @@index([userId, createdAt])
  @@index([firmaId])
  /// ⚠ ustteki yorum BAYAT ve indeks YANLIS KOLONDA. `findAll` firma gocunden
  /// (`f45fd2f`) beri `where: { firmaId }` + `orderBy: { createdAt }` kosuyor;
  /// yani en sik sorgu artik kullanici-basina DEGIL FIRMA-basina. Bilesik
  /// indeks `[userId, createdAt]` bu sorguya HIC yardim etmiyordu — tek
  /// kolonlu `[firmaId]` bulunuyor, siralama sonra bellekte yapiliyordu.
  /// Durum suzgeci de ayni sorguya bindigi icin dogru bilesik indeks bu:
  @@index([firmaId, createdAt])
}

/// TEKLIF SATIS DURUMU (FAZ 4.6). Enum degerleri UPPER_SNAKE + Turkce —
/// AbonelikDurumu/FaturaDurumu/HavaleDurumu ile ayni dil.
enum TeklifDurumu {
  HAZIRLANIYOR // varsayilan; teklif uzerinde calisiliyor (bkz. `taslak` carpisma notu)
  GONDERILDI // musteriye iletildi, cevap bekleniyor
  KAZANILDI // is alindi
  KAYBEDILDI // is baska firmaya gitti / iptal
}

// PRD Teklif Formatim: kullanicinin KENDI teklif sablonu (.xlsx —
// KAPAK + ICMAL + istege bagli sartlar sayfalari, {{YER_TUTUCU}}'lu).
model QuoteFormat {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  firmaId   String? // ADIM 1 gecis: null=atanmamis; suzgecler backfill sonrasi buna doner
  name      String
  fileName  String
  // Orijinal format workbook'u — ciktida kapak/icmal buradan kopyalanir.
  // Guncelleme YENI bytes yazar; uretilmis eski ciktilar etkilenmez (T11).
  fileBytes Bytes
  // Tarama sonucu: {bulunan: [{etiket, sheet, addr}], taninmayan: [...]} (T3)
  mapping   Json?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  quotes    Quote[]

  @@index([userId])
  @@index([firmaId])
}

// T10: dis aktarim arsivi — her Rev'in uretilmis .xlsx'i saklanir.
// PDF saklanmaz (ayni rev verisinden yeniden uretilebilir).
model QuoteExport {
  id                String   @id @default(uuid())
  quote             Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId           String
  rev               Int
  fileName          String
  xlsxBytes         Bytes
  // O rev'de uygulanmis onizleme duzenlemeleri (Rev.02, Rev.01'i baz alir)
  overridesSnapshot Json?
  createdAt         DateTime @default(now())

  @@unique([quoteId, rev])
  @@index([quoteId])
}

model QuoteItem {
  id                 String     @id @default(uuid())
  quote              Quote      @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId            String
  materialName       String
  unit               String     @default("Adet")
  brand              Brand?     @relation(fields: [brandId], references: [id])
  brandId            String?
  laborFirma         LaborFirm? @relation(fields: [laborFirmaId], references: [id])
  laborFirmaId       String?
  quantity           Float
  // Malzeme fiyatlari
  materialUnitPrice  Float      @default(0)
  materialTotalPrice Float      @default(0)
  materialMargin     Float      @default(0) // %
  // Iscilik fiyatlari
  laborUnitPrice     Float      @default(0)
  laborTotalPrice    Float      @default(0)
  laborMargin        Float      @default(0) // %
  // Toplamlar
  totalUnitPrice     Float      @default(0)
  totalPrice         Float      @default(0)
  // Eski alanlar (geriye uyumluluk)
  unitPrice          Float      @default(0)
  discount           Float      @default(0)
  netPrice           Float      @default(0)
  profitMargin       Float      @default(0)
  finalPrice         Float      @default(0)
}

enum Discipline {
  mechanical
  electrical
}

model LaborItem {
  id             String       @id @default(uuid())
  name           String
  unit           String       @default("Adet")
  unitPrice      Float // varsayilan/baz fiyat
  discipline     Discipline
  category       String?
  description    String?
  tags           String[]     @default([]) // LEGACY v1 (kaldirilacak — su an dokunulmuyor)
  normalizedName String? // LEGACY v1
  isGlobal       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  laborPrices    LaborPrice[]

  // ── PRD Iscilik L2: 7-kolon kaynak sadakati (ProductIndex deseni) ──
  // AD = name (mevcut). Cins/Cap/Boy/Not asagida; Birim = unit (mevcut);
  // Fiyat/ParaBirimi LaborPrice'ta (firma bazli).
  cins     String?
  baglanti String?
  capRaw   String?
  boyMm    Float?
  not      String?

  // ── ON-HESAP (v2 indeks — ProductIndex ile AYNI alanlar, AYNI uretici:
  // buildProductIndex/rebuildIndexFields. Ayri tablo = ayri bucket seti;
  // malzeme sorgulari iscilik satiri GOREMEZ — PRD L9 tek MOTOR, D1 karari).
  adSlug         String?
  adBucket       String?
  adTokens       String[] @default([])
  cinsNorm       String?
  cinsTokens     String[] @default([])
  baglantiNorm   String?
  baglantiTokens String[] @default([])
  sizeClass      String   @default("unknown")
  // S4/S5 — ProductIndex ile AYNI alanlar, AYNI uretici (buildProductIndex).
  // Ikiz tablolarin birinde olup digerinde olmamasi, ayni kuralin malzeme
  // yolunda calisip iscilik yolunda sessizce dusmesi demektir.
  malzemeler     String[] @default([])
  aileZayif      Boolean  @default(false)
  capTags        String[] @default([])
  capNorm        String?
  boyTag         String?
  displayName    String?
  // 0 = indekssiz/legacy → istek aninda canli tokenizer'la turetilir
  // (matching.service hazirlaPool yol-3 deseni); reindex kalicilastirir.
  indexVersion   Int      @default(0)
  // adSlug cozulemedi + ad anlamsiz → BEKLEYEN (eslesmeye aday olamaz, L2)
  belirsiz       Boolean  @default(false)

  @@index([discipline])
  @@index([name])
  @@index([tags], type: Gin)
  @@index([adSlug])
}

// LaborFirm KULLANICIYA AIT — her kullanici kendi firmalarini olusturur
model LaborFirm {
  id          String           @id @default(uuid())
  name        String
  discipline  Discipline
  logo        String?
  createdAt   DateTime         @default(now())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  firmaId     String? // ADIM 1 gecis: null=atanmamis; suzgecler backfill sonrasi buna doner
  laborPrices LaborPrice[]
  priceLists  LaborPriceList[]
  quoteItems  QuoteItem[]

  // G7 (28.08): tekillik KISI'den FIRMA'ya tasindi — UserBrandLibrary'de
  // ADIM 1'de yapilan degisikligin ayni gerekcesi: iscilik firmasi FIRMAYA
  // ait. Tekillik kisi bazli kalsaydi ayni firmanin iki uyesi AYNI isimde
  // iki iscilik firmasi acabilir, teklif ekraninda firma CIFT gorunurdu.
  // Bugun cakisma imkansiz (her firmada tek uye) — gecis simdi guvenli.
  @@unique([firmaId, name])
  @@index([userId])
  @@index([discipline])
  @@index([firmaId])
}

model LaborPriceList {
  id         String       @id @default(uuid())
  name       String
  firma      LaborFirm    @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  firmaId    String
  uploadedAt DateTime     @default(now())
  sheets     Json? // ExcelGrid raw sheet — yuklenen dosyanin sheet icerigi (tek sheet, multi-row header, grup basliklari)
  prices     LaborPrice[]
}

model LaborPrice {
  id           String          @id @default(uuid())
  laborItem    LaborItem       @relation(fields: [laborItemId], references: [id], onDelete: Cascade)
  laborItemId  String
  firma        LaborFirm       @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  firmaId      String
  priceList    LaborPriceList? @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  priceListId  String?
  unitPrice    Float // liste fiyat
  discountRate Float           @default(0) // iskonto %
  unit         String          @default("Adet")
  // PRD Iscilik L2: para birimi CEVRILMEZ — ham saklanir, teklif aninda
  // toTry ile cevrilir (malzeme UserLibrary.currency ile ayni kural).
  currency     String          @default("TRY")
  createdAt    DateTime        @default(now())

  @@unique([laborItemId, firmaId, priceListId])
  @@index([firmaId])
  @@index([laborItemId])
}

model AiUsageLog {
  id               String  @id @default(uuid())
  feature          String // 'pdf_parse' | 'excel_match' | 'quote_analyze' | 'translate'
  provider         String // 'claude' | 'gemini' | 'openrouter'
  model            String? // 'claude-opus-5' etc.
  // ⚠ Bu sayilar 12.08'e kadar UYDURMAYDI (cagri yerlerinde elle yazilmis
  // sabitler; `response.usage` hic okunmuyordu). Artik API'nin dondurdugu
  // gercek olcum yazilir — bkz. ai-maliyet.ts.
  inputTokens      Int     @default(0)
  outputTokens     Int     @default(0)
  // Onbellek tokenlari AYRI tutulur: farkli fiyatlanirlar (okuma ~0.1x,
  // yazma 1.25x) ve cevirinin ekonomisi ONBELLEK ISABET ORANIYLA olculur.
  cacheWriteTokens Int     @default(0)
  cacheReadTokens  Int     @default(0)
  estimatedCost    Float   @default(0) // USD — liste fiyati uzerinden
  success          Boolean @default(true)
  errorMessage     String?

  /// ATIF (07.09.2026) — bu cagrinin maliyeti KIME yazilacak.
  /// Plan (2.6): "Anthropic faturasinin hangi kullanicidan geldigini goremiyorsunuz."
  /// ⚠ NULLABLE ve FK'siz, BILEREK:
  ///  1. Mevcut satirlarin sahibi BILINMIYOR; NOT NULL migration'i patlatirdi.
  ///  2. Kullanici yumusak silinince (User.deletedAt) maliyet kaydi KALMALI —
  ///     FK + Cascade fatura gecmisini silerdi.
  ///  3. Admin tetikli cagrida (havuz PDF ayiklama) userId dolar ama firmaId
  ///     bos kalabilir: masraf bir musteriye ait DEGILDIR.
  userId  String?
  firmaId String?

  createdAt DateTime @default(now())

  @@index([feature])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([firmaId, createdAt])
}

/// TEKNIK METIN CEVIRI ONBELLEGI (13.08).
///
/// NEDEN KALICI ONBELLEK: teklif sayfalari 15.000+ satir olabiliyor ama
/// malzeme adlari MASIF sekilde tekrarliyor ("DN 20", "DN 25"... her baslik
/// altinda yeniden). Benzersizlestirince 15 bin satir birkac yuz metne
/// iner; ikinci teklifte ayni metinler zaten burada oldugu icin API cagrisi
/// SIFIRA yaklasir.
///
/// KULLANICIYA OZEL DEGIL (global): teknik terimler evrenseldir — "Küresel
/// vana" her kullanicida "ball valve"dir. Global olmasi onbellek isabetini
/// katbekat artirir.
///
/// `kaynak` alani AI cevirisi ile YONETICI DUZELTMESINI ayirir: duzeltme
/// yazildiginda bir daha AI'ya sorulmaz ve her teklifte gecerli olur.
///
/// FAZ 6.9 (T2): `kaynak='manual'` = YÖNETİCİ düzeltmesi (ORTAK katman; yazımı
/// `YoneticiOlayi` `ceviri.ortak.duzeltildi` bırakır). Kullanıcı bu tabloya
/// hiçbir uçtan yazamaz: firma düzeltmesi `CeviriDuzeltmesi`nde durur ve okuma
/// anında ortağın ÜSTÜNE biner (siler değil).
model Translation {
  id             String   @id @default(uuid())
  sourceText     String // normalize edilmis kaynak metin
  targetLang     String // 'en'
  translatedText String
  kaynak         String   @default("ai") // 'ai' | 'manual'
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([sourceText, targetLang])
  @@index([targetLang])
}

/// FAZ 6.2 — ÇEVİRİ TÜKETİM KAYDI (14.09.2026).
///
/// Her çeviri isteği TAM OLARAK BİR kayıt bırakır — tamamen önbellekten dönen
/// dahil. `AiUsageLog` bu işi yapamaz (13.09 ölçümü): parça (60 metin) başına
/// satır yazar, satır/dosya alanı yoktur ve tamamı önbellekten dönen çeviride
/// HİÇ satır yazmaz. Kota bu tablodan sayılır.
///
/// ⚠ FK YOK, BİLEREK (AiUsageLog ile aynı gerekçe + bir fazlası):
///  1. Teklif silinince kayıt KALMALI. Cascade'li bir FK ile kullanıcı çevirip
///     teklifi silerek kotasını geri alabilirdi.
///  2. Kullanıcı yumuşak silinse de dönem kullanımı firmada kalmalı.
///
/// Dönem alanları istek anındaki abonelik dönemini DENETİM İÇİN taşır; sayım
/// `olusturuldu` aralığıyla yapılır (çapa değişse de kayıt kaybolmaz).
///
/// ⚠ SAYIM `dusulenSatir` ÜZERİNDENDİR, `satirSayisi` DEĞİL. 15.09'dan (REVİZE
/// K-T7, hepsi ya da hiçbiri) itibaren çeviri ya tamamlanır (BASARILI, satırın
/// tamamı düşer) ya hiç düşmez (BASARISIZ). 14.09-15.09 arası yazılmış KISMI ve
/// `devam` kayıtları geçmiş tüketim olarak sayılmaya devam eder.
///
/// Ödenmiş içerik kanıtı (Faz 6.11): aynı firma + teklif + dil + özet için
/// BASARILI kayıt — pencere ve dönem süzgeci yok (`ceviri-kota.servisi.ts`).
model CeviriTuketimi {
  id               String              @id @default(uuid())
  firmaId          String
  userId           String
  abonelikId       String
  paketKodu        String
  donemBaslangic   DateTime
  donemBitis       DateTime
  quoteId          String
  hedefDil         String              @default("en")
  /// Teklifin çevrilecek metin içeren satır sayısı (tanım a) — istek anında.
  satirSayisi      Int
  /// Kotadan düşen satır = API'ye GİDEN (para harcanan) satır (Emre 16.09).
  /// İŞLENİYOR iken ayrılan; sonuçlanınca tamda API'den dönen satır, eksikte 0.
  /// 16.09 öncesi kayıtlarda teklifin satırının tamamı (o gün kural buydu).
  dusulenSatir     Int                 @default(0)
  /// Ortak önbellek / firma sözlüğünden karşılanan, kotadan DÜŞMEYEN satır
  /// (denetim: düşen ile düşmeyen ayrık dursun). 16.09 öncesi kayıtlarda 0.
  onbellektenSatir Int                 @default(0)
  /// Teslim edilen satır. 15.09 öncesi kayıtlarda devam zincirinin toplamı; yeni kayıtta tamda satırın tamamı, eksikte 0.
  toplamTeslim     Int                 @default(0)
  /// true → (yalnız 15.09 öncesi kayıtlar) yarım kalan çevirinin devamı; dosya hakkından yemez. Yeni kayıtta daima false.
  devam            Boolean             @default(false)
  /// API'ye aday benzersiz metin sayısı (önbellek öncesi).
  metinSayisi      Int
  /// Çeviriyi belirleyen içeriğin özeti. v2 = çoklu küme (`ceviri-ozet-v2:`, sıra/miktar duyarsız);
  /// T1 (15.09) öncesi kayıtlar v1 (sıralı dizi) taşır — ödenmiş içerik kanıtı ikisini de tanır.
  icerikOzeti      String
  durum            CeviriTuketimDurumu @default(ISLENIYOR)
  onbellekten      Int                 @default(0)
  cevrilen         Int                 @default(0)
  basarisizParca   Int                 @default(0)
  hata             String?
  olusturuldu      DateTime            @default(now())
  sonuclandi       DateTime?

  @@index([firmaId, olusturuldu])
  @@index([firmaId, quoteId, icerikOzeti, olusturuldu])
}

/// ISLENIYOR  — kota ayrıldı, çeviri sürüyor (kotaya SAYILIR; zaman aşımında sayılmaz)
/// BASARILI   — tüm satırlar teslim edildi (`dusulenSatir` kotaya SAYILIR)
/// KISMI      — 15.09 sonrası ÜRETİLMEZ (hepsi ya da hiçbiri); eski kayıtlar için durur, sayılır ama kanıt değildir
/// BASARISIZ  — hiç satır teslim edilmedi (kotaya SAYILMAZ; tekrar denenebilir)
enum CeviriTuketimDurumu {
  ISLENIYOR
  BASARILI
  KISMI
  BASARISIZ
}

/// FAZ 6.9 — FİRMA ÇEVİRİ DÜZELTMESİ (insan katmanı, 16.09.2026).
/// Okuma sırası firma → ortak (Translation) → API. Firma düzeltmesi ortağı EZER, SİLMEZ.
/// Ortak katman (Translation) makine çevirisi + yönetici düzeltmesidir; kullanıcı yazamaz.
/// ⚠ TEKİLLİK HAM METİNDE DEĞİL ÖZETTE: Postgres btree satır tavanı ~2,7 KB; uzun
/// şartname satırı ham metin indeksini "index row size exceeds maximum" ile patlatır.
/// ⚠ FK YOK, BİLEREK: CeviriTuketimi / AiUsageLog / YoneticiOlayi deseni — firma ya da
/// kullanıcı kaydı değişse de sözlük ve iz kalır; migration-zinciri K1 bloğu etkilenmez.
model CeviriDuzeltmesi {
  id            String   @id @default(uuid())
  firmaId       String
  hedefDil      String   @default("en")
  /// ceviriAnahtari ile normalize kaynak (eşleşme doğrulaması + gösterim)
  kaynakMetin   String
  /// sha256(kaynakMetin) hex — `ceviri-katmani.ts` `kaynakOzeti`
  kaynakOzeti   String
  ceviriMetni   String
  olusturanId   String
  guncelleyenId String
  olusturuldu   DateTime @default(now())
  guncellendi   DateTime @updatedAt

  @@unique([firmaId, hedefDil, kaynakOzeti])
  @@index([firmaId, guncellendi])
}

/// FAZ 6.9 — FİRMA ÇEVİRİ DÜZELTME OLAYI (denetim izi, K-T12).
/// Düzeltme yazımıyla AYNI transaction'da ve firma kilidi altında yazılır: ya ikisi ya hiçbiri.
/// `kullaniciEposta` anlık kopyadır (YoneticiOlayi deseni): hesap kapatılsa da iz okunur.
model CeviriDuzeltmeOlayi {
  id              String   @id @default(uuid())
  firmaId         String
  userId          String
  kullaniciEposta String
  /// 'eklendi' | 'guncellendi' | 'kaldirildi'
  tip             String
  duzeltmeId      String?
  hedefDil        String
  kaynakMetin     String
  oncekiDeger     String?
  yeniDeger       String?
  /// o anda ortak katmanın karşılığı (yalnız iz; KVKK indirmesi DAHİL hiçbir yolla istemciye DÖNMEZ — Revizyon 1)
  ortakDeger      String?
  olusturuldu     DateTime @default(now())

  @@index([firmaId, olusturuldu])
  @@index([userId, olusturuldu])
}

/// K1 DONMUS OZEL FIYAT YEDEGI (tur 3 A4c, 14.09) — migration
/// 20260914180000_k1_donmus_ozel_fiyat'in NULL'a cektigi `UserLibrary.customPrice`
/// degerleri. Geri alma: migration dosyasindaki GERI ALMA blogu (yalniz hala
/// NULL olan satiri yazar). Semada DURMAK ZORUNDA: `prisma db push` semada
/// olmayan tabloyu siler. FK yok: kutuphane satiri silinse de iz kalir.
model KutuphaneOzelFiyatYedegi {
  userLibraryId   String   @id
  firmaId         String?
  eskiCustomPrice Float
  listPrice       Float
  kaynakFiyat     Float
  /// 'K1-donmus-ozel-fiyat'
  sebep           String
  temizlendi      DateTime @default(now())
}

model SystemSettings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

/// DWG DOSYA SAHIPLIGI (G2 guvenlik turu, 28.08).
///
/// ⚠ NEDEN VAR — OLCULMUS CAPRAZ-TENANT SIZINTI:
/// DWG dosyalari Python servisinin cache'inde `file_id` anahtariyla durur ve
/// bu anahtarin KIME ait oldugunu soyleyen HICBIR KAYIT YOKTU. Yedi ucun
/// hicbiri kullaniciyi parametre olarak bile ALMIYORDU (ne @CurrentUser ne
/// req.user), dolayisiyla firma suzgeci YAPISAL OLARAK IMKANSIZDI.
///
/// Somut sonuc: `GET /api/dwg-engine/geometry/:fileId` ve `/status/:fileId`
/// uclarinda fileId'yi bilen HERHANGI bir oturumlu kullanici BASKA bir
/// firmanin projesinin koordinatlarini okuyabiliyordu. Musteri projeleri
/// ticari sirdir; mimari cizimin geometrisi projenin ta kendisidir.
///
/// Bu tablo fileId→firma bagini kurar: uretici uclar (layers/upload) kaydi
/// YAZAR, tuketici uclar (parse/status/geometry) DOGRULAR.
/// Python servisi DONMUS BLOK'tur (klasor-duzeni.txt) — oraya dokunulmadi;
/// izolasyon tamamen Nest katmaninda kuruldu.
model DwgDosya {
  id          String   @id @default(uuid())
  /// Python servisinin cache anahtari.
  fileId      String   @unique
  firmaId     String
  /// Yukleyen kisi (denetim izi; dosya FIRMAYA ait olsa da bir KISI yukler).
  olusturanId String
  dosyaAdi    String?
  olusturuldu DateTime @default(now())

  @@index([firmaId, olusturuldu])
}

// ═══════════════════════════════════════════════════════════════════════════
//  ADIM 2 (28.08) — ABONELIK & ODEME
// ═══════════════════════════════════════════════════════════════════════════
//
//  TASARIM ILKESI: iyzico kaynak degil TAHSILAT SERVISIDIR. "Bu firma
//  uygulamayi kullanabilir mi" sorusunun cevabi DAIMA bu tablolardan gelir;
//  iyzico'ya sorulmaz. iyzico'dan gelen bilgi bu tablolari GUNCELLER,
//  karari VERMEZ. Sebep: iyzico'ya giden her istek gecikme ve ariza
//  noktasidir, ustelik havale ile odeyen firmalarin iyzico'da kaydi yoktur.
//
//  ⚠ PROJE UYARLAMASI (paketten sapmalar — kasitli):
//   1. `cuid()` DEGIL `uuid()` — semadaki diger 26 modelin tamami uuid.
//   2. `@@map("paket")` YOK — mevcut tablolar PascalCase (User, Brand,
//      UserSubscription); tek semada iki adlandirma dili tutulmaz.
//   3. Paket'e `kapsam` + `seviye` EKLENDI (pakette YOKTU). Sebep asagida.
// ═══════════════════════════════════════════════════════════════════════════

/// Paket tanimi — fiyattan BAGIMSIZ kimlik. "Profesyonel Paket" gibi;
/// fiyati degisse de bu kayit ayni kalir, degisen PaketSurumu olur.
///
/// ⭐ KAPSAM + SEVIYE (28.08 kullanici karari): gelen pakette paket DUZ idi
/// (tek `dwgAktif` boolean'i) — oysa urun DISIPLIN BAZLI satiliyor
/// (UserSubscription.scope = mechanical|electrical|mep, admin panelde
/// "pro·MEP" rozetleri). Duz paket bir GERILEME olurdu: mep ile mechanical
/// ayrimi ve ayri fiyatlandirma imkani kaybolurdu.
///
/// Bu yuzden paket kapsam+seviye tasir ve `capabilities` matrisi artik
/// firmanin Abonelik→PaketSurumu→Paket zincirinden TURETILIR (tek dogru
/// kaynak). Frontend sozlesmesi ({mechanical:{material,labor,dwg},
/// electrical:{...}}) AYNI kalir — hicbir bilesen kirilmaz.
/// Bkz. capabilities.helper.ts.
model Paket {
  id       String  @id @default(uuid())
  kod      String  @unique // "pro-mep", "core-mek"
  ad       String
  aciklama String?
  sira     Int     @default(0)

  /// Hangi disiplin(ler)e erisim verir. `mep` ikisini birden acar.
  /// Mevcut SubscriptionScope enum'u YENIDEN KULLANILIYOR — yeni bir enum
  /// tanimlamak ayni kavrami iki adla tasimak olurdu.
  kapsam SubscriptionScope
  /// core = malzeme. pro = malzeme + iscilik + dwg.
  /// Mevcut PackageLevel enum'u yeniden kullaniliyor (ayni gerekce).
  seviye PackageLevel

  /// Firma basina azami kullanici (davet akisi bunu okuyacak).
  kullaniciHakki   Int     @default(5)
  /// null = sinirsiz. ⚠ ZORLANMIYOR — kota uygulamak icin teklif olusturma
  /// ucuna sayac eklemek gerekir (bilinen sinir, OKUBENI.md'de de yazili).
  aylikTeklifHakki Int?
  /// `seviye`den bagimsiz DWG anahtari. Normalde pro=true/core=false, ama
  /// ayrik tutuluyor: "dwg'siz pro" ya da "dwg'li core" paketi satilabilsin.
  /// ErisimServisi bu alani okur (erisim.servisi.ts).
  dwgAktif         Boolean @default(true)

  aktif       Boolean       @default(true)
  surumler    PaketSurumu[]
  olusturuldu DateTime      @default(now())

  @@index([aktif, sira])
}

/// Paket surumu — fiyatin DONDURULMUS hali.
/// iyzico'da Pricing Plan olusturulduktan sonra fiyati DEGISTIRILEMEZ.
/// Bu yuzden her fiyat degisikligi yeni bir PaketSurumu + yeni iyzico plani
/// demektir. Eski aboneler eski surumde kalir; bu tablo onu kaydeder.
model PaketSurumu {
  id      String @id @default(uuid())
  paketId String
  paket   Paket  @relation(fields: [paketId], references: [id])
  surumNo Int

  /// iyzico tarafindaki karsiliklari.
  iyzicoPlanKodu String @unique // pricingPlanReferenceCode
  iyzicoUrunKodu String // productReferenceCode

  /// ── FAZ 6.12a (15.09): DENEMESIZ IKIZ PLAN ──────────────────────────────
  /// Ayni urun, ayni fiyat/periyot, `trialPeriodDays = 0` olan ikinci iyzico
  /// plani. Deneme gunu iyzico'da PLANA yazilir (abonelik baslatma istegi
  /// deneme alani TASIMAZ) — deneme hakki daha once kullanilmis firmaya
  /// "yerelde AKTIF yaz" yetmez: iyzico denemeli planla 30 gun cekmez.
  /// ⚠ NULL iken hakki olmayan satin alma KAPALI HATA (503) verir; ASLA
  /// denemeli plana dusulmez (satinalma.servisi.ts `planSec`). Kod
  /// `paketleri-kur.ts --denemesiz-ikiz --uygula` ile iyzico yanitindan yazilir.
  iyzicoDenemesizPlanKodu String? @unique

  /// SOZLESME TUTARI — kartlan gercekten cekilen, faturaya yazilan tutar.
  /// ⚠ KDV DAHIL brut tutardir: iyzico abonelik planinda ayri KDV satiri
  /// YOKTUR, plan fiyati ne ise o cekilir. `fatura.servisi` bu tutari
  /// KDV DAHIL kabul edip matrahi geriye hesaplar (satir 64-67).
  /// Decimal(12,2): para asla float tutulmaz (bkz. P2 turu, 03.08 dersi).
  tutar      Decimal @db.Decimal(12, 2)
  paraBirimi String  @default("TRY") // TRY | USD | EUR

  // ── GORUNEN FIYAT (capa) — 29.08 kullanici karari ────────────────────
  //
  // Musteriye "$28/ay" denir, karttan TL cekilir. Gerekce ticari: "24
  // dolar" kucuk bir tutar gibi durur, "1.250 TL" buyuk bir para gibi.
  // Ayvaz'in euro fiyat listesi + TL fatura kesmesiyle ayni kalip.
  //
  // ⚠ SOZLESME TUTARI `tutar`DIR (TL). Bu alanlar YALNIZCA GOSTERIM icin;
  // hicbir tahsilat, fatura ya da erisim karari bunlari OKUMAZ. Ayrim
  // kasitli: doviz cinsinden BEDEL BELIRLEMEK ile doviz cinsinden FIYAT
  // GOSTERMEK ayri seylerdir — ikincisi yerlesikler arasi sozlesmelerde
  // soru isareti dogurmaz.
  //
  // ⚠ ZAMANLA KAYAR: TL sabitlendigi icin kur oynadikca bu capa gercekten
  // uzaklasir. Bu yuzden capa YALNIZCA SATIS ANINDA (satistaki surumde)
  // gosterilir; mevcut abone kendi TL tutarini gorur. Kur oynayinca YENI
  // surum acilir ve capa yeniden dogru olur.
  referansTutar      Decimal?  @db.Decimal(12, 2) // orn. 28.00
  referansParaBirimi String? // orn. "USD"
  /// Bu surum kurulurken kullanilan TCMB kuru ve tarihi — DENETIM IZI.
  /// "Bu fiyat nereden cikti" sorusunun cevabi; tahminle degil kayitla.
  kurDegeri          Decimal?  @db.Decimal(12, 4)
  kurTarihi          DateTime?
  periyot            String    @default("MONTHLY") // DAILY|WEEKLY|MONTHLY|YEARLY
  periyotAdedi       Int       @default(1)
  denemeGunu         Int       @default(0)

  /// Yeni satisa kapaliysa false; MEVCUT ABONELER ETKILENMEZ.
  satistaMi   Boolean            @default(true)
  olusturuldu DateTime           @default(now())
  abonelikler Abonelik[]         @relation("AbonelikPaketi")
  /// Bu surume DONEM SONUNDA gecmek uzere planlanmis abonelikler (23.09).
  planliAbonelikler Abonelik[]   @relation("AbonelikPlanliPaketi")
  baslatmalar AbonelikBaslatma[]
  /// Bu surume gecmeyi oneren yonetici onerileri (A2 Blok 2).
  oneriler    PaketDegisimOnerisi[]
  /// Bu surum icin verilmis havale teklifleri (25.09) — onayda etkin paket olur.
  havaleTeklifleri HavaleOdemesi[]

  @@unique([paketId, surumNo])
  @@index([satistaMi])
}

/// Aboneligin sahibi KULLANICI DEGIL FIRMA'dir (ADIM 1 ekseni).
///
/// ⚠ `firmaId` ZORUNLU ve @unique: bir firmanin en fazla bir aboneligi olur.
/// Bu, User.firmaId'nin nullable olmasina ragmen guvenlidir — kayit akisi
/// her kullaniciya atomik olarak firma acar (auth.service.ts register).
model Abonelik {
  id            String      @id @default(uuid())
  firmaId       String      @unique
  firma         Firma       @relation(fields: [firmaId], references: [id])
  /// ETKIN paket — erisim, yetenek, koltuk ve kota kararlarinin TAMAMI bunu
  /// okur (16 dosya, 23.09 olcumu). Planli bir dusurme BU ALANI dondurmaz;
  /// gecis aninda bu alan YAZILIR (bkz. `planliPaketSurumuId`).
  paketSurumuId String
  paketSurumu   PaketSurumu @relation("AbonelikPaketi", fields: [paketSurumuId], references: [id])

  // ── PAKET DEGISIMI (23.09.2026 — Emre karari) ─────────────────────────
  // Yukseltme: ozellikler HEMEN (`paketSurumuId` yazilir), ucret DONEM
  // SONUNDA. Dusurme ve yatay gecis: ozellik de ucret de DONEM SONUNDA.
  // iyzico'ya her iki yonde de `NEXT_PERIOD` gider — `NOW` kist hesap
  // yapmaz, cakisan sureyi IKI KEZ cektirir (docs/RAPOR_ADIM0, 20.08).
  //
  // ⚠ NEDEN "HER OKUYUCUDA ETKIN PAKETI HESAPLA" DEGIL: `paketSurumu`nu
  // okuyan 16 dosya var. Planli paketi okuma aninda turetmek, 16 yerin
  // hepsine ayni kurali yazmak demekti — birini unutmak (bu deponun olculmus
  // "ikizi unutma" hatasi) ayni firmaya iki ekranda iki paket gosterirdi.
  // Gecis TEK YERDE yazilir: `AbonelikServisi.planliGecisiUygula`; iki
  // tetigi var (yenileme webhook'u + 10 dakikalik tarama).

  /// Donem sonunda gecilecek paket (dusurme / yatay). NULL = planli yok.
  planliPaketSurumuId String?
  planliPaketSurumu   PaketSurumu? @relation("AbonelikPlanliPaketi", fields: [planliPaketSurumuId], references: [id])
  /// iyzico'daki yeni planin BASLADIGI an (yeni ucretin ilk cekimi). DOLU
  /// oldugu surece degisim KILITLIDIR — tarih gecse bile: kilit ancak yeni
  /// ucun ILK BASARILI TAHSILATI gorulunce kalkar (webhook), ya da 3 gunluk
  /// emniyet suresi dolunca. Gerekce: iyzico'nun bekleyen (henuz baslamamis)
  /// uca ikinci yukseltme davranisi OLCULMEDI — iki plan ayni anda baslarsa
  /// cift cekim olur. Tarih "gecti" diye kilidi bizim saatimizle acmak,
  /// iyzico'nun cekim partisi gec kosarsa o yolu acardi (inceleme bulgusu 4).
  paketGecisTarihi    DateTime?
  /// HEMEN uygulanan yukseltmede, yeni ucretin ilk cekimine kadar ODENMIS
  /// olan paket. Bu surede iptal gelirse etkin paket BUNA doner: yukseltip
  /// hemen iptal eden firma, hic odemedigi ust paketi donem sonuna kadar
  /// kullanamaz — aksi tekrarlanabilir bir istismardi (her ay Basic al,
  /// MEP'e gec, iptal et). FK yok: kisa omurlu isaretci, deger her zaman
  /// `paketSurumuId`den kopyalanir.
  odenenPaketSurumuId String?

  durum AbonelikDurumu @default(DENEME)

  /// Erisimin bittigi AN. Kart odemesinde iyzico'dan gelen donem sonu,
  /// havalede elle uzatilan tarih. ERISIM KARARI BU ALANA BAKAR — durum ne
  /// olursa olsun bu tarih gecmisse erisim kapanir (ikinci emniyet kemeri:
  /// zamanlanmis is gec kosarsa bile bedava kullanim olmaz).
  erisimSonu DateTime
  denemeSonu DateTime?

  /// "DENEME SURENIZ BITIYOR" E-POSTASI GITTI MI (25.09.2026, Emre: ilk
  /// cekimden 3 gun once, bir kez). Gunluk tarama (`DenemeHatirlatmasiServisi`)
  /// e-postayi gondermeden ONCE bu alani KOSULLU yazar (`null` iken) — ayni
  /// satiri iki tur / iki surec ayni anda gorse de yalniz biri yazar ve
  /// gonderir (TAM BIR KEZ). Gonderim duserse alan geri `null`a cekilir,
  /// sonraki tur yeniden dener. NULL = hatirlatma gitmedi. Deneme hakki firma
  /// basina BIR kez oldugu icin alan sifirlanmaz.
  denemeHatirlatmasi DateTime?

  /// SATIN ALMANIN KOPRU TARIHI (24.09.2026). Kart satin almasi `erisimSonu`nu
  /// iyzico'nun gercek donem sonunu bilmeden TAMPONLU bir kopru degerle yazar
  /// (`donemTarihleriHesapla`: deneme ya da 31 gun + 2 gun tampon); o deger
  /// burada da tutulur. Ilk basarili tahsilat webhook'u kopruyu iyzico'nun
  /// `endPeriod`una DUZELTIR, gerekirse KISALTIR — ama YALNIZ `erisimSonu` HALA
  /// bu degere esitse. Baska her durumda (miras gocunun 365 gunu, havale,
  /// yonetici, onceki donem) webhook `erisimSonu`nu yalniz UZATIR: kisaltma
  /// pozitif kanit ister. NULL = duzeltilecek kopru yok (satin almada erisim
  /// zaten suruyordu ya da kopru ilk tahsilatla kapandi).
  kopruErisimSonu DateTime?

  /// iyzico bagi — HAVALE ile odeyen firmalarda null kalir.
  /// ⚠ BU KOD DEGISKENDIR: paket degisiminde (upgrade/downgrade) iyzico
  /// YENI bir subscriptionReferenceCode uretir, eskisi UPGRADED olur ve
  /// uzerinde hicbir islem yapilamaz. Bkz. `iyzicoKokKodu`.
  iyzicoAbonelikKodu String? @unique // subscriptionReferenceCode (GUNCEL uc)

  /// ⚠ ZINCIR KOKU — plan degisiminde DEGISMEYEN tek kimlik.
  ///
  /// OLCULMUS DAVRANIS (docs/RAPOR_ADIM0_iyzico_Sandbox.md, 20.08):
  /// upgrade/downgrade YENI bir abonelik referansi uretir; yeni kayit
  /// `parentReferenceCode` ile eskisine baglanir, eski kayit UPGRADED
  /// durumuna duser ve terminal hale gelir (`201402 yukseltilemez`,
  /// `201403 iptal edilemez` — ikisi de olculdu).
  ///
  /// Bu alan olmadan: paket degisiminden sonra gelen webhook YENI kodla
  /// gelir, `iyzicoAbonelikKodu` ile eslesmez ve olay "bilinmeyen abonelik
  /// kodu" diye YUTULUR — musteri odemesine ragmen aboneligi guncellenmez.
  /// Raporun kendi cumlesi: "webhook eslemesi zincir koküyle yapilmali".
  iyzicoKokKodu     String?
  iyzicoMusteriKodu String? // customerReferenceCode
  iyzicoDurum       String? // ACTIVE|PENDING|UNPAID|CANCELED|EXPIRED|UPGRADED
  iyzicoSonKontrol  DateTime? // mutabakat isinin son bakisi

  odemeYontemi OdemeYontemi @default(KART)

  /// Dunning (tahsilat kurtarma) durumu.
  ilkBasarisizlik DateTime?
  denemeSayisi    Int       @default(0)
  sonDeneme       DateTime?
  kisitlandi      DateTime? // salt-okunur moda gecis ani

  /// Musteri iptal etti — donem sonuna kadar erisim SURER.
  iptalTalebi DateTime?
  iptalNedeni String?

  olusturuldu DateTime @default(now())
  guncellendi DateTime @updatedAt

  olaylar   AbonelikOlayi[]
  faturalar Fatura[]
  havaleler HavaleOdemesi[]

  @@index([durum, erisimSonu])
  @@index([durum, sonDeneme]) // dunning taramasi bu indeksi kullanir
  // Zincir kokuyle arama: webhook YENI kodla geldiginde bu indeks kullanilir.
  @@index([iyzicoKokKodu])
  // Planli gecis taramasi (10 dk) — yalniz dolu satirlar ilgilenir.
  @@index([paketGecisTarihi])
}

enum PaketOnerisiDurumu {
  BEKLIYOR
  KABUL_EDILDI
  REDDEDILDI
  GERI_CEKILDI
  /// Baska bir degisiklik oneriyi gecersiz kildi (ya da suresi doldu) ve
  /// bir yazim yolu bunu kaydetti. Okuma yollari kapanisi HESAPLAR
  /// (`paket-onerisi.ts` `oneriDurumu`), satiri beklemez.
  KAPANDI
}

/// ═══════════════════════════════════════════════════════════════════════════
///  PAKET DEGISIM ONERISI (24.09.2026, yonetici paneli turu A2 Blok 2)
/// ═══════════════════════════════════════════════════════════════════════════
/// Emre (23.09): yonetici YUKSELTIRSE musteriye onay baglantisi gider. Oneri
/// paketi DEGISTIRMEZ: firma SAHIBI A1'in penceresinden (sozlesme onayiyla)
/// `POST /abonelik/degistir` + `oneriId` ile kabul eder — tek yol, tek cekirdek.
///
/// ⚠ "BASKA DEGISIKLIK OLURSA KAPANIR" ANLIK GORUNTUYLE: `kaynak*` alanlari
/// oneri anindaki abonelik. Etkin paket ya da iyzico ucu farkliysa oneri
/// KAPANMIS sayilir — degisimi yapan yol (musteri, yonetici, donem sonu
/// gecisi, yeni satin alma) oneriden HABERSIZ olsa bile. Her yola "oneriyi
/// kapat" satiri eklemek, birini unutmayi (bu deponun olculmus hatasi) davet
/// ederdi.
model PaketDegisimOnerisi {
  id                  String             @id @default(uuid())
  /// `onDelete` YAZILMAZ: firma silinmez (FirmaDavet ile ayni gerekce).
  firmaId             String
  firma               Firma              @relation(fields: [firmaId], references: [id])
  /// BEKLIYOR iken `firmaId`, sonuclaninca NULL. Firma basina TEK bekleyen
  /// oneri kuralinin VERITABANI kilidi: kuyruk tek sureci siralar, bu
  /// benzersizlik ikinci sureci de durdurur (P2002 → 409). Kismi indeks
  /// DEGIL — o yalniz SQL'de yasar ve `migrate dev` sapma sanip dusurebilirdi.
  bekleyenFirmaId     String?            @unique
  durum               PaketOnerisiDurumu @default(BEKLIYOR)
  hedefPaketSurumuId  String
  hedefPaketSurumu    PaketSurumu        @relation(fields: [hedefPaketSurumuId], references: [id])
  /// Oneri anindaki ETKIN paket ve iyzico ucu (anlik goruntu). FK yok:
  /// karsilastirma icin kopya (`odenenPaketSurumuId` ile ayni gerekce).
  kaynakPaketSurumuId String
  kaynakIyzicoKodu    String?
  /// IC gerekce — musteriye GOSTERILMEZ (denetim icin).
  gerekce             String
  /// Yalniz firma SAHIBINE gosterilir (e-posta + abonelik sayfasi).
  musteriNotu         String?
  sonGecerlilik       DateTime
  olusturanId         String
  olusturanEposta     String
  /// Kabul / ret / geri cekme / kapanis ani ve yapan (kapanista NULL).
  sonuclandi          DateTime?
  sonuclandiranId     String?
  kapanisNedeni       String?
  olusturuldu         DateTime           @default(now())

  @@index([firmaId, olusturuldu])
}

/// Satin alma NIYETI — barindirilan iyzico formu acildiginda yazilir.
///
/// ⚠ NEDEN ZORUNLU (para kaybettiren delik): iyzico'nun donus adresine SADECE
/// opak bir `token` gonderilir; govdede firmaId ya da plan bilgisi YOKTUR.
/// Bu tablo olmasaydi token'i bir firmaya baglamanin YOLU OLMAZDI.
///
/// Asil senaryo: musteri karti girdi, tahsilat GECTI, ama donus sayfasi
/// yuklenmeden sekmeyi kapatti. O anda:
///   · Abonelik satiri hic olusmamis olur,
///   · iyzico webhook'u `subscriptionReferenceCode` ile gelir,
///   · webhook.isleyici o kodla EŞLEŞEN ABONELIK BULAMAZ ve olayi
///     "bilinmeyen abonelik kodu" diye yutup islendi=true isaretler.
/// Sonuc: MUSTERI ODEDI, ERISIM ACILMADI ve gunlukte tek satir iz kalir.
///
/// Bu tablo + `AbonelikBaslatmaJob` o dongu icin kurtarma yolu acar: donusu
/// gelmemis niyetler icin iyzico'ya `formSonucu(token)` ile SORULUR ve
/// tahsilat gectiyse abonelik SUNUCU TARAFINDA acilir. Yani erisim,
/// musterinin tarayicisini acik tutmasina BAGLI DEGILDIR.
model AbonelikBaslatma {
  id            String      @id @default(uuid())
  /// iyzico checkout form token'i — donus bununla eslesir.
  token         String      @unique
  firmaId       String
  paketSurumuId String
  paketSurumu   PaketSurumu @relation(fields: [paketSurumuId], references: [id])

  /// Formu acan kisi (denetim izi; abonelik FIRMAYA ait olsa da niyeti
  /// bir KISI olusturur).
  olusturanId String

  // ── FAZ 6.12a (15.09): DENEME KARARI NIYET ANINDA DONDURULUR ────────────
  // Sonuclandirma donusten ya da 10 dakikalik kurtarma taramasindan gelir;
  // o anda form verisi (e-posta, telefon) YOKTUR. Karar ve anahtarlar
  // iyzico formu acilirken yazilir, sonuclandirma YALNIZ bunlari okur.
  /// iyzico'ya giden plana gore deneme gunu. NULL = satir bu alan eklenmeden
  /// ONCEKI kodla yazildi; o kod her zaman surumun denemeli planini
  /// gonderiyordu, sonuclandirma `paketSurumu.denemeGunu`na duser.
  denemeGunu       Int?
  /// iyzico'ya gonderilen plan kodu (denemeli ya da denemesiz ikiz).
  planKodu         String?
  /// Deneme kaydi anahtarlari (deneme-hakki.ts ile normalize): hesap
  /// e-postasi, iyzico formuna yazilan e-posta, form telefonu.
  epostaNormal     String?
  formEpostaNormal String?
  telefonNormal    String?

  // ── FAZ 6.4 (16.09): MESAFELI SATIS ONAYININ IZI ────────────────────────
  // Satin alma adiminda "On Bilgilendirme Formu'nu ve Mesafeli Satis
  // Sozlesmesi'ni okudum, onayliyorum" kutusu ZORUNLU. Bir onay kaydinin
  // degeri "onayladi" bilgisinde degil, HANGI METNI ve NE ZAMAN onayladigi
  // bilgisindedir; ikisi de niyet satirinda kalir ve abonelik acildiktan
  // sonra da izlenebilir olur.
  /// Onay kutusunun isaretlendigi an — SUNUCU saatiyle damgalanir.
  /// NULL = satir bu alanlar eklenmeden ONCEKI kodla yazildi (o kod onay
  /// KUTUSU GOSTERMIYORDU); gecmise donuk onay UYDURULMAZ.
  sozlesmeOnayiZamani DateTime?
  /// Onaylanan hukuki metin surumu (`altyapi/auth/hukuki-surum.ts`).
  sozlesmeSurumu      String?

  durum              AbonelikBaslatmaDurumu @default(BEKLIYOR)
  /// Sonuclandiginda iyzico'nun verdigi abonelik kodu.
  iyzicoAbonelikKodu String?
  hata               String?

  /// Kurtarma taramasinin son bakisi — ayni niyeti sonsuz sorgulamamak icin.
  sonKontrol   DateTime?
  denemeSayisi Int       @default(0)

  olusturuldu DateTime  @default(now())
  sonuclandi  DateTime?

  @@index([durum, olusturuldu])
}

enum AbonelikBaslatmaDurumu {
  BEKLIYOR // form acildi, donus gelmedi
  TAMAMLANDI // abonelik acildi
  BASARISIZ // iyzico odemeyi reddetti ya da firmanin etkin aboneligi varken ikinci form tamamlandi (ikinci abonelik iptal edildi)
  VAZGECILDI // pencere doldu, tahsilat da gecmemis
}

/// ═══════════════════════════════════════════════════════════════════════════
///  FAZ 6.12a (15.09) — DENEME KULLANIM KAYDI: ucretsiz deneme BIR KEZ
/// ═══════════════════════════════════════════════════════════════════════════
///
/// ⚠ NEDEN AYRI TABLO: deneme karari eskiden yalniz `PaketSurumu.denemeGunu`
/// > 0 sorusuna bakiyordu; hicbir kimlige bagli degildi. `Abonelik` satiri
/// yeniden alimda `denemeSonu`nu EZER ve hesap kapatma e-postayi serbest
/// birakir — "bu firma/kisi daha once deneme aldi mi" sorusunun kalici izi
/// yoktu. Olculen tekrar yollari: ayni firma iptal/sona erdi, deneme sonu
/// tahsilat basarisiz, hesap kapat + ayni e-posta, yeni e-posta + ayni
/// telefon, ayni e-postanin buyuk harfli bicimi.
///
/// Satin almada (deneme gunu > 0 olan niyet TAMAMLANDI olurken) bir satir yazilir.
/// Anahtarlardan HERHANGI BIRI bir satirla eslesirse deneme hakki YOKTUR;
/// satin alma engellenmez, denemesiz ikiz plana gider.
///
/// ⚠ FK YOK ve CASCADE YOK (bilincli): hesap kapatma ya da ileride veri
/// imhasi bu satiri SILMEMELI — tablonun varlik sebebi kotuye kullanimin
/// onlenmesidir. Aydinlatma metninde amac ve saklama yaziyor; KVKK veri
/// indirmesi bu kayitlari da dondurur (hesap.servisi.ts).
///
/// TC kimlik ve kart parmak izi BU TURDA YOK (karar K-P1): form sonucu kart
/// alani tasimiyor ve denemede tahsilat olmadigi icin karar aninda kart yok.
model DenemeKullanimi {
  id                 String   @id @default(uuid())
  firmaId            String
  /// Formu acan kisi. Miras (gecis) kaydinda NULL.
  kullaniciId        String?
  /// Kaynak niyet. Kurtarma taramasi ayni niyeti ikinci kez sonuclandirirsa
  /// ikinci satir YAZILMAZ (upsert anahtari).
  abonelikBaslatmaId String?  @unique
  /// Hesap e-postasi (kapatilmis hesapta kapatilanEposta), normalize.
  epostaNormal       String?
  /// iyzico formuna yazilan e-posta, normalize.
  formEpostaNormal   String?
  /// Telefonun son 10 hanesi.
  telefonNormal      String?
  iyzicoMusteriKodu  String?
  /// deneme = satin almada verildi · geriye-donuk = migration doldurmasi ·
  /// miras = gecis firmasinin hakki gecis doneminde kullanilmis sayildi.
  kaynak             String
  olusturuldu        DateTime @default(now())

  @@index([firmaId])
  @@index([epostaNormal])
  @@index([formEpostaNormal])
  @@index([telefonNormal])
}

enum AbonelikDurumu {
  DENEME // deneme suresi, tam erisim
  AKTIF // odemeler duzenli, tam erisim
  ODEME_BEKLIYOR // tahsilat basarisiz, tolerans suresinde — HALA tam erisim
  KISITLI // tolerans doldu — salt okunur
  ASKIDA // erisim kapali, sadece odeme sayfasi
  IPTAL // musteri iptal etti, donem sonuna kadar erisim suruyor
  SONA_ERDI // bitti
}

enum OdemeYontemi {
  KART // iyzico abonelik
  HAVALE // havale/EFT, elle uzatma
}

/// Webhook ham kaydi + tekillestirme.
///
/// iyzico ayni olayi 15 dakikada bir, TOPLAM 3 KEZ gonderir (~45 dk pencere);
/// sonra olay KALICI OLARAK KAYBOLUR. Bu yuzden controller SADECE buraya
/// yazip 200 doner, isleme sonra yapilir. Bu sirayi bozmayin.
model WebhookOlayi {
  id String @id @default(uuid())

  /// Tekillestirme anahtari — ayni olayin ikinci gelisi burada takilir (P2002).
  tekilAnahtar String @unique

  kaynak      String  @default("iyzico")
  olayTipi    String // subscription.order.success | subscription.order.failure
  hamGovde    Json
  imzaBasligi String?
  imzaGecerli Boolean @default(false)

  /// iyzico'nun gonderdigi alanlar.
  abonelikKodu  String?
  siparisKodu   String? // orderReferenceCode — retry bunu ister
  musteriKodu   String?
  iyzicoRefKodu String?
  olayZamani    DateTime?

  islendi       Boolean   @default(false)
  islenmeZamani DateTime?
  denemeSayisi  Int       @default(0)
  hata          String?

  alindi DateTime @default(now())

  @@index([islendi, alindi])
  @@index([abonelikKodu])
}

/// Abonelik olay gunlugu (denetim izi).
/// Bir musteri "ben odedim ama hesabim kapandi" dediginde TEK bakilacak yer.
model AbonelikOlayi {
  id         String   @id @default(uuid())
  abonelikId String
  abonelik   Abonelik @relation(fields: [abonelikId], references: [id])

  tip         String // tahsilat.basarili, dunning.deneme, durum.degisti…
  oncekiDurum String?
  yeniDurum   String?
  aciklama    String?
  veri        Json?
  /// "sistem", "webhook", ya da yonetici kullanici ID'si.
  aktor       String   @default("sistem")
  olusturuldu DateTime @default(now())

  @@index([abonelikId, olusturuldu])
}

/// YONETICI DENETIM KAYDI — kim, ne zaman, hangi kullaniciya, ne yapti.
///
/// Neden: /admin altindaki alti mutasyon ucu (rol, durum, paket, silme,
/// abonelik ekle/kaldir) bugune kadar HICBIR iz birakmiyordu. Bir kullanicinin
/// rolu degistiginde ya da hesabi silindiginde bunu kimin yaptigi hicbir yerde
/// yazmiyordu. Kurumsal satin alma sureclerinde ilk sorulan seylerden biridir.
///
/// Sekil AbonelikOlayi'ndan (satir ~1132) KOPYALANDI: ayni alan adlari, ayni
/// `aktor` sozlesmesi, ayni `veri Json?` kacis kapisi. Yeni bir usul ICAT
/// EDILMEDI.
///
/// FK YOK (hedefKullaniciId ham String): silinen bir kullanicinin denetim
/// kaydi da silinirse kayit anlamsizlasir — denetim kaydinin varlik sebebi
/// tam olarak "o kullaniciya ne oldu" sorusudur.
model YoneticiOlayi {
  id String @id @default(uuid())

  /// Islemi YAPAN yoneticinin User.id'si.
  yoneticiId    String
  /// Denetim kaydi kullanici silinse bile okunabilir kalsin diye e-posta da
  /// KOPYALANIR (anlik goruntu). Iliskiden turetmek, silme sonrasi bosalirdi.
  yoneticiEpsta String

  /// Islemin UYGULANDIGI kullanici. FK YOK — bilerek (yukaridaki nota bak).
  hedefKullaniciId String?
  hedefEposta      String?

  /// rol.degisti, durum.degisti, paket.degisti, kullanici.silindi,
  /// abonelik.eklendi, abonelik.kaldirildi,
  /// ceviri.ortak.duzeltildi (Faz 6.9: ORTAK çeviri katmanına yönetici yazımı)
  tip         String
  oncekiDeger String?
  yeniDeger   String?
  veri        Json?
  olusturuldu DateTime @default(now())

  @@index([hedefKullaniciId, olusturuldu])
  @@index([yoneticiId, olusturuldu])
  @@index([olusturuldu])
}

/// e-Arsiv / e-Fatura.
/// iyzico MUSTERINIZE fatura KESMEZ, yalnizca kendi komisyonunu size
/// faturalar. Her tahsilatta e-arsiv/e-fatura uretmek SIZIN yukumlulugunuz.
model Fatura {
  id         String   @id @default(uuid())
  abonelikId String
  abonelik   Abonelik @relation(fields: [abonelikId], references: [id])

  /// Tekillestirme: ayni tahsilat icin IKI fatura kesilmesin.
  tahsilatKodu String @unique // orderReferenceCode ya da havale kaydi ID'si

  durum       FaturaDurumu @default(BEKLIYOR)
  tutar       Decimal      @db.Decimal(12, 2)
  kdvOrani    Int          @default(20)
  kdvTutari   Decimal      @db.Decimal(12, 2)
  toplamTutar Decimal      @db.Decimal(12, 2)
  paraBirimi  String       @default("TRY")

  /// Muhasebe entegrasyonu (Parasut vb.).
  saglayici   String?
  saglayiciId String?
  faturaNo    String?
  faturaUrl   String?

  /// ── K4 (21.09.2026) — FATURA KENDI KOPYASINI TASIR ────────────────────
  /// VUK md. 230 faturada musterinin adi/unvani, adresi, vergi dairesi ve
  /// numarasini sart kosuyor. Bu alanlar ONCEDEN `Firma` satirindan CANLI
  /// okunuyordu; iki kusur vardi:
  ///   1. Veri imhasi firma satirini bosaltinca saklanan faturalar eksik
  ///      kalirdi (yasal saklama bozulur).
  ///   2. IMHADAN BAGIMSIZ DA YANLIS: musteri adresini degistirince GECEN
  ///      YILIN faturasi da yeni adresi gosteriyordu. Fatura, kesildigi ANIN
  ///      bilgisini tasimak zorundadir.
  /// Faturayi okuyan her yer BU alanlari okur, `Firma` satirini DEGIL.
  /// ⚠ Geriye doldurma YOK: olculdu (21.09) canlida 0 fatura kaydi var;
  /// gecmisi bugunku firma bilgisiyle doldurmak zaten yanlis veri uretirdi.
  musteriUnvan        String?
  musteriVergiDairesi String?
  musteriVergiNo      String?
  musteriTcKimlikNo   String?
  musteriAdres        String?
  musteriIl           String?
  musteriIlce         String?

  denemeSayisi Int       @default(0)
  sonDeneme    DateTime?
  hata         String?

  donemBasi   DateTime
  donemSonu   DateTime
  olusturuldu DateTime  @default(now())
  kesildi     DateTime?

  @@index([durum, sonDeneme])
}

enum FaturaDurumu {
  BEKLIYOR
  KESILDI
  HATA
  ELLE_MUDAHALE // otomatik deneme tukendi, insan bakmali
  IPTAL
}

/// Havale / EFT odemesi.
/// Taahhut firmalarinda kurumsal kart limitleri dusuktur; yillik pesin havale
/// cogu zaman TERCIH EDILEN satin alma bicimidir. Kartin yanina BIRINCI SINIF
/// bir yol olarak konur, sonradan eklenen bir istisna olarak degil.
/// iyzico bu akisa HIC karismaz: iyzicoAbonelikKodu null kalir, dunning
/// taramasi bu kayitlari atlar (where odemeYontemi:'KART').
model HavaleOdemesi {
  id         String   @id @default(uuid())
  abonelikId String
  abonelik   Abonelik @relation(fields: [abonelikId], references: [id])

  /// TEKLIFIN PAKETI (25.09.2026 — Emre karari: "onayda hemen uygula").
  /// Onay (`HavaleServisi.odemeyiOnayla`) bu surumu aboneligin ETKIN paketi
  /// yapar. Eskiden hic saklanmiyordu: mevcut satirda teklifin paketi yok
  /// sayiliyor, Basic musteri Pro teklifini odeyince Basic kaliyordu (fatura
  /// da "Basic" yaziyordu; olculdu `test:havale-teklif-paketi`).
  /// NULL = bu alan eklenmeden ONCE olusturulmus teklif: onay paketi
  /// DEGISTIRMEZ (hangi paket icin verildigi bilinmiyor — tahmin yok).
  paketSurumuId String?
  paketSurumu   PaketSurumu? @relation(fields: [paketSurumuId], references: [id])

  durum      HavaleDurumu @default(TEKLIF)
  tutar      Decimal      @db.Decimal(12, 2)
  paraBirimi String       @default("TRY")
  ayAdedi    Int // kac ay uzatilacak

  /// Belge izi.
  teklifNo  String? @unique
  faturaNo  String?
  dekontUrl String?
  aciklama  String?

  /// Kim onayladi. ⚠ aktor JWT'den alinir, ISTEK GOVDESINDEN DEGIL.
  onaylayanId   String?
  onaylandi     DateTime?
  uzatilanTarih DateTime?

  olusturuldu DateTime @default(now())
  guncellendi DateTime @updatedAt

  @@index([durum, olusturuldu])
}

enum HavaleDurumu {
  TEKLIF // teklif iletildi
  FATURA_KESILDI
  ODEME_BEKLENIYOR
  ONAYLANDI // dekont dogrulandi, abonelik uzatildi
  IPTAL
}

/// ═══════════════════════════════════════════════════════════════════════════
///  FAZ 7 F1b — EKIP DAVETI
/// ═══════════════════════════════════════════════════════════════════════════
/// Sekil `PasswordResetToken`dan KOPYA (`token-ozet.ts`): duz token YALNIZ
/// e-postada gorunur, DB'de SHA-256 ozeti durur; tek kullanim; sure sinirli.
///
/// ⚠ ROL KOLONU YOK — davet HER ZAMAN `uye` uretir. Sahiplik katildiktan
/// sonra "Sahip yap" ile verilir; boylece sizan bir davet baglantisi
/// sahiplik sizintisi OLAMAZ.
///
/// ⚠ "Bekleyen davet" tanimi TEK yerde: `uyelik-kurallari.ts`
/// (`kabulAt IS NULL AND iptalAt IS NULL AND sonGecerlilik > now()`).
/// Ayni firma + ayni e-posta icin IKINCI bekleyen davet acilmaz; ikinci
/// istek YENIDEN GONDERIMDIR. Prisma kismi tekil indeks yazamadigi icin bu
/// kural firma kilidinin (`firmaKilitliIslem`) icinde serviste uygulanir.
model FirmaDavet {
  id              String    @id @default(uuid())
  firmaId         String
  firma           Firma     @relation(fields: [firmaId], references: [id])
  /// Normalize: `epostaKucult` (trim + ASCII kucuk harf) — kayit/giris ile
  /// AYNI kural (eposta.ts); ayri bir normalizasyon YAZILMAZ.
  eposta          String
  tokenHash       String    @unique
  sonGecerlilik   DateTime
  kabulAt         DateTime?
  kabulEdenId     String?
  iptalAt         DateTime?
  iptalEdenId     String?
  davetEdenId     String
  davetEdenEposta String
  /// 23.09.2026 — sahibin davet aninda sectigi izinler. Kabulde yeni hesaba
  /// AYNEN kopyalanir (`uyelik.servisi.ts` `davetKabul`).
  izinler         UyeIzni[] @default([excel, dwg, firmaTeklifleri, kutuphane])
  gonderimSayisi  Int       @default(1)
  sonGonderimAt   DateTime  @default(now())
  olusturuldu     DateTime  @default(now())

  @@index([firmaId, kabulAt, iptalAt])
  @@index([eposta])
  @@index([sonGecerlilik])
}

/// ═══════════════════════════════════════════════════════════════════════════
///  FAZ 7 F1b — FIRMA DENETIM KAYDI
/// ═══════════════════════════════════════════════════════════════════════════
/// Firma SAHIBININ (ve sistemin) uye/guvenlik islemleri. `YoneticiOlayi`na
/// YAZILMAZ: orada `yoneticiId` "platform yoneticisi" demektir. FK YOK —
/// gerekce `YoneticiOlayi` ile ayni (silinen hesabin izi kaybolmasin).
///
/// ⚠ `veri`, `oncekiDeger`, `yeniDeger` HICBIR ZAMAN istemci sirri, sifreli
/// deger (`v1.` onekli), TOTP sirri, kurtarma kodu ya da token tasimaz; sir
/// degisikligi yalniz `veri: { sirDegisti: true }` olarak kaydedilir.
///
/// ⚠ Alan adi `aktorEposta` — `YoneticiOlayi.yoneticiEpsta` YAZIM HATASIDIR,
/// kopyalanmaz.
model FirmaOlayi {
  id               String   @id @default(uuid())
  firmaId          String
  /// null = sistem (or. kurumsal girisle otomatik katilim)
  aktorId          String?
  aktorEposta      String?
  hedefKullaniciId String?
  hedefEposta      String?
  tip              String
  oncekiDeger      String?
  yeniDeger        String?
  veri             Json?
  olusturuldu      DateTime @default(now())

  @@index([firmaId, olusturuldu])
  @@index([hedefKullaniciId, olusturuldu])
}

/// ═══════════════════════════════════════════════════════════════════════════
///  FAZ 7 F3b — KURUMSAL GIRIS (OIDC)
/// ═══════════════════════════════════════════════════════════════════════════

enum KimlikSaglayiciTipi {
  entra
  google
}

enum KimlikSaglayiciDurumu {
  /// Kaydedildi, baglanti sinanmadi.
  TASLAK
  /// Sahip kendi kurumsal hesabiyla sinadi, en az bir alan adi KANITLANDI.
  DOGRULANDI
  /// Giris ekraninda gorunur.
  ETKIN
  /// Sahip kapatti (ayar durur, kimseye gorunmez).
  KAPALI
}

/// FIRMA BASINA TEK kurumsal kimlik saglayicisi (`firmaId @unique`).
model FirmaKimlikSaglayici {
  id                        String                @id @default(uuid())
  firmaId                   String                @unique
  firma                     Firma                 @relation(fields: [firmaId], references: [id])
  tip                       KimlikSaglayiciTipi
  /// tip=entra: kiraci GUID'i (kucuk harf). 'common'/'organizations'/'consumers'
  /// ve kisisel hesap kiracisi 9188040d-6c67-4c5b-b112-36a304b66dad REDDEDILIR.
  entraKiraciId             String?
  /// Kayit aninda KODDA turetilir, formdan ALINMAZ.
  /// ⚠ R1-D5: YALNIZ gosterim/denetim. id_token dogrulamasinda beklenen iss
  /// HER ZAMAN `beklenenIssuer(tip, entraKiraciId)`'den gelir (Google icin iki
  /// degerli dizi) — bu kolon o cagriya ASLA gecirilmez.
  issuer                    String
  clientId                  String
  /// AES-256-GCM, AAD `idp:<id>`. Yanitlarda ASLA donmez (yalniz `sirVar: true`).
  istemciSirriSifreli       String
  /// Entra'da sahibin girdigi bitis tarihi (14 gun kala uyari).
  istemciSirriSonGecerlilik DateTime?
  /// Sahibin yazdigi alan adlari — KANIT DEGIL. Kanitlanan `DogrulanmisAlanAdi`.
  beyanAlanAdlari           String[]
  durum                     KimlikSaglayiciDurumu @default(TASLAK)
  /// V8: hesabi olmayan calisan ilk giriste (bos koltuk varsa) uye olur.
  jitKatilim                Boolean               @default(true)
  /// V7: parolayla giris kapali (izinli alan adindaki uyeler icin).
  zorunlu                   Boolean               @default(false)
  sonSinamaAt               DateTime?
  sonHataKodu               String?
  /// Istemci sirri bitis uyarisi gunde en fazla bir kez gider.
  sonSirUyarisiAt           DateTime?
  olusturuldu               DateTime              @default(now())
  guncellendi               DateTime              @updatedAt
  dogrulanmisAlanAdlari     DogrulanmisAlanAdi[]
  disKimlikler              KullaniciDisKimlik[]
}

/// Bir alan adi TUM SISTEMDE en fazla bir firmada dogrulanmis olabilir: `@id`
/// tekildir. Beyan (TASLAK) tekil DEGIL — bir saldirgan baskasinin alan adini
/// "once yazarak" gercek firmayi engelleyemesin. Satir YALNIZ sinama girisi
/// kanit verdiginde yazilir.
model DogrulanmisAlanAdi {
  alanAdi      String               @id
  saglayiciId  String
  saglayici    FirmaKimlikSaglayici @relation(fields: [saglayiciId], references: [id], onDelete: Cascade)
  firmaId      String
  dogrulayanId String
  dogrulandiAt DateTime             @default(now())

  @@index([firmaId])
}

/// "Kullanici gocu"nun TAMAMI: dis kimlik → mevcut `User.id` eslemesi.
model KullaniciDisKimlik {
  id            String                @id @default(uuid())
  userId        String
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  saglayiciId   String?
  saglayici     FirmaKimlikSaglayici? @relation(fields: [saglayiciId], references: [id], onDelete: SetNull)
  /// Dogrulanmis `iss` (entra: kiraciya ozel) — esleme anahtarinin yarisi.
  issuer        String
  /// entra: `oid` (kiraci `issuer` icinde ve `tid` ayrica dogrulanir) · google: `sub`.
  subject       String
  entraKiraciId String?
  /// Baglandigi andaki e-posta — YALNIZ denetim. Yetki/esleme kararinda OKUNMAZ.
  epostaAnlik   String?
  /// 'acik-baglama' | 'eposta-eslesme' | 'otomatik-katilim' | 'sinama'
  baglamaYolu   String
  olusturuldu   DateTime              @default(now())
  sonGirisAt    DateTime?

  @@unique([issuer, subject])
  @@unique([userId, issuer])
  @@index([saglayiciId])
}

/// SSO akis durumu — DB'de (deploy'da kopmaz; tek kopyada da cok kopyada da
/// TEK KULLANIM). ⚠ CEREZ YOK: hukuki metinler "platform hicbir yerde cerez
/// yazmiyor" diyor (`metinler.ts`, faz5 E3 kapisi) — bag `sessionStorage`
/// sekme sirrinin OZETIDIR.
model SsoAkisi {
  id                 String    @id @default(uuid())
  /// sha256(state). state duz metin yalniz IdP URL'inde gezer.
  durumOzeti         String    @unique
  /// sha256(sekmenin `sessionStorage` sirri) — akisi BASLATAN sekmeye baglar.
  tarayiciBagiOzeti  String
  /// FK YOK: akis 10 dk yasar; saglayici silinirse donus "SAGLAYICI_YOK" der.
  saglayiciId        String
  /// 'giris' | 'sinama' | 'bagla'
  amac               String
  /// amac sinama/bagla: akisi baslatan OTURUM sahibi (Bearer ile baslatilir).
  baslatanUserId     String?
  nonce              String
  /// PKCE code_verifier — duz; omru 10 dk ve tek basina ise yaramaz.
  pkceDogrulayici    String
  olusturuldu        DateTime  @default(now())
  sonGecerlilik      DateTime
  /// Donus islendi = state TUKENDI (ikinci donus reddedilir).
  donusAt            DateTime?
  /// Donuste DOGRULANMIS id_token'dan cikarilan ozet (yan etki YOK; kararlar
  /// `degis` aninda verilir). Kisisel veri: akis bitince null'lanir; satir
  /// 24 sa sonra silinir.
  dogrulanmisKimlik  Json?
  /// Donus sonucu: 60 sn tek kullanimlik degis kodu.
  sonucKoduOzeti     String?   @unique
  sonucSonGecerlilik DateTime?
  sonucKullanildiAt  DateTime?
  /// Donus asamasinda olusan hata (IdP reddi, imza, kiraci, misafir…) — KOD yalniz.
  hataKodu           String?
  /// Otomatik katilim onayi bileti (10 dk, tek kullanim).
  biletOzeti         String?   @unique
  biletSonGecerlilik DateTime?
  biletKullanildiAt  DateTime?

  @@index([sonGecerlilik])
}
